<Window Style="{StaticResource {x:Type Window}}" x:Class="Cogana.Admin.Escritorio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controles="clr-namespace:Cogana.Admin.Escritorio.Controles"
        mc:Ignorable="d"
        Title="Cogana Admin"
        Height="850"
        Width="1440"
        MinHeight="720"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrochaFondo}">

    <Window.Resources>
        <Style x:Key="TextoMenuExpandido" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsMenuCompacto, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColumnaMenu" Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menú principal -->
        <Border x:Name="ContenedorMenu" Grid.RowSpan="2"
                Margin="16,16,0,16"
                Background="{StaticResource BrochaSuperficie}"
                BorderBrush="#10000000"
                BorderThickness="1"
                CornerRadius="22"
                Padding="12,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource LogoCogana}" RenderOptions.BitmapScalingMode="HighQuality" Width="48" Height="48" Stretch="Uniform" AutomationProperties.Name="Logo de Cogana" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextoMenuExpandido}">
                        <TextBlock Text="COGANA" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Administración" Foreground="{StaticResource BrochaTextoSuave}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BotonAlternarMenu" Grid.Row="1" Content="‹  Contraer menú" Click="AlAlternarMenu"
                        Style="{StaticResource BotonSecundario}" Height="32" Padding="4" Margin="0,12,0,8"
                        ToolTip="Contraer o expandir el menú" AutomationProperties.Name="Contraer o expandir menú" />

                <ListBox x:Name="MenuModulos" Grid.Row="2"
                         ItemsSource="{Binding Modulos}"
                         SelectedItem="{Binding ModuloSeleccionado}"
                         SelectionChanged="AlCambiarModulo"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="AlPresionarOpcionPanel" />
                            <EventSetter Event="PreviewMouseMove" Handler="AlMoverOpcionPanel" />
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="AlSoltarOpcionMenu" />
                            <EventSetter Event="LostMouseCapture" Handler="AlPerderCapturaMenu" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="{Binding Nombre}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource BrochaTexto}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="FondoOpcion"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="12" BorderBrush="Transparent" BorderThickness="1"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <ContentPresenter />
                                                <Ellipse x:Name="PuntoActivo" Width="5" Height="5" Fill="White" Visibility="Collapsed"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="FondoOpcion" Property="BorderBrush" Value="#737373"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FondoOpcion" Property="Background" Value="#14000000" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="FondoOpcion" Property="Background" Value="{StaticResource BrochaNegro}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter TargetName="PuntoActivo" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="FondoOpcion" Property="Effect">
                                                    <Setter.Value><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.13" /></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="27" Height="27" CornerRadius="9"
                                        Background="#12000000">
                                    <TextBlock Text="{Binding Inicial}" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontSize="13" Style="{StaticResource TextoMenuExpandido}"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                           VerticalAlignment="Center" Margin="7,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Una capa sobre todo el menú permite que los anillos crucen las filas vecinas. -->
                <controles:EfectoSeleccionMenu x:Name="EfectoSeleccion" Grid.Row="2" Panel.ZIndex="10" />

                <StackPanel Grid.Row="3">
                <Border Background="White" CornerRadius="14" Padding="6,10" Margin="0,12,0,0" ToolTip="{Binding CorreoUsuario}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BrochaAcentoSuave}">
                            <TextBlock Text="{Binding InicialesUsuario}" Foreground="{StaticResource BrochaAcento}" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextoMenuExpandido}">
                            <TextBlock Text="{Binding CorreoUsuario}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RolUsuario}" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                        </StackPanel>
                    </Grid>
                </Border>
                    <Button x:Name="BotonCerrarSesion" Content="Cerrar sesión" Click="AlCerrarSesion"
                            Style="{StaticResource BotonSecundario}" Margin="0,8,0,0"
                            HorizontalContentAlignment="Center" Padding="4,8" AutomationProperties.Name="Cerrar sesión" ToolTip="Cerrar esta sesión y volver al acceso" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área de trabajo -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding ModuloSeleccionado.Nombre}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="28" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding FechaActual}" FontSize="13" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock Text="  •  " FontSize="13" Foreground="#A2A7A3" />
                            <TextBlock Text="{Binding ModuloSeleccionado.Descripcion}" FontSize="13" Foreground="{StaticResource BrochaTextoSuave}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="Cargando contenido…" Margin="0,0,12,0" VerticalAlignment="Center"
                               FontSize="11" AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding EstaCargandoInicio, Converter={StaticResource BoolAVisibilidad}}" />

                    <Button Grid.Column="2" Content="Actualizar resumen"
                            Command="{Binding VerificarConexionCommand}"
                            Height="40" Padding="16,8">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BotonPrincipal}"><Style.Triggers>
                            <DataTrigger Binding="{Binding EstaCargandoInicio}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>

                <UniformGrid x:Name="ResumenReal" controles:RevelacionContenido.Activa="True" Grid.Row="1" Columns="4" Margin="0,20,0,16">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsModuloInicio}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger><MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding EsModuloInicio}" Value="True" />
                                    <Condition Binding="{Binding EstaCargandoInicio}" Value="True" />
                                </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Hidden" /></MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>
                    <Border Style="{StaticResource Tarjeta}" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Productos activos" FontSize="12" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock Text="{Binding ProductosActivos}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding CategoriasActivas, StringFormat={}{0} categorías activas}" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Lotes por vencer" FontSize="12" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock Text="{Binding LotesPorVencer}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Próximos 30 días" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Pedidos pendientes" FontSize="12" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock Text="{Binding PedidosPendientes}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Requieren atención" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BrochaNegro}" CornerRadius="22" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Estado de tienda" FontSize="12" Foreground="#BFC4C0" />
                            <TextBlock Text="{Binding EstadoTienda}" FontSize="23" FontWeight="SemiBold" Foreground="White" Margin="0,9,0,0" />
                            <TextBlock Text="{Binding DetalleEstadoTienda}" FontSize="11" Foreground="#BFC4C0" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Grid Grid.Row="1" Margin="0,20,0,16" Visibility="{Binding EsModuloInicio, Converter={StaticResource BoolAVisibilidad}}">
                    <controles:SkeletonCarga x:Name="SkeletonResumen" Tipo="Resumen" Activo="{Binding EstaCargandoInicio}" MinHeight="120" />
                </Grid>

                <Border Grid.Row="2"
                        x:Name="ZonaWidgets">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="22" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsModuloInicio}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Tu panel" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Arrastra un módulo del menú izquierdo para agregarlo aquí. Reordena las tarjetas desde su cabecera y quítalas con ✕."
                                           FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2"
                                x:Name="ZonaDestinoWidgets"
                                Margin="0,16,0,0"
                                MinHeight="180"
                                AllowDrop="True"
                                BorderThickness="2"
                                CornerRadius="20"
                                PreviewDragOver="AlArrastrarModuloSobrePanel"
                                PreviewDragLeave="AlSalirArrastreModulo"
                                PreviewDrop="AlSoltarModuloEnPanel">
                            <Border.Style><Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Binding="{Binding TieneWidgetsInicio}" Value="False">
                                    <Setter Property="BorderBrush" Value="#D2D2D2"/>
                                    <Setter Property="Background" Value="#F3F3F3"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                            <Grid>
                        <ItemsControl ItemsSource="{Binding WidgetsInicio}"
                                      x:Name="TableroWidgets" AllowDrop="True"
                                      DragOver="AlArrastrarTarjetaSobreTablero"
                                      DragLeave="AlSalirArrastreTarjeta"
                                      Drop="AlSoltarTarjetaEnTablero">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controles:TableroAdaptable AnchoMinimoTarjeta="330" MaximoColumnas="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Tarjeta}" Padding="18" Margin="0,0,10,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Background="Transparent" Cursor="SizeAll"
                                                  MouseMove="AlMoverTarjetaParaOrdenar"
                                                  ToolTip="Arrastra para reordenar esta sección">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource BrochaAcentoSuave}">
                                                    <TextBlock Text="{Binding Inicial}" Foreground="{StaticResource BrochaAcento}"
                                                               FontSize="12" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock
                                                               FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" >
            <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding Total, StringFormat={}{0} registros en Supabase}" />
                <Style.Triggers><DataTrigger Binding="{Binding EstaCargando}" Value="True"><Setter Property="Text" Value="Consultando datos…" /></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="✕" Click="AlQuitarWidget"
                                                        ToolTip="Quitar sección del panel"
                                                        Style="{StaticResource BotonSecundario}" Padding="10,5" FontSize="11" />
                                            </Grid>

                                            <Grid Grid.Row="1" MinHeight="150" Margin="0,12,0,0">
                                                <controles:SkeletonCarga Tipo="Tarjeta" Activo="{Binding EstaCargando}" />
                                                <Grid controles:RevelacionContenido.Activa="True">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsReporte}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EstaCargando}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                <ItemsControl ItemsSource="{Binding Filas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BrochaBorde}" BorderThickness="0,0,0,1" Padding="2,9">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="125" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Columna1}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Columna2}" FontSize="11" Margin="8,0,8,0"
                                                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrochaTextoSuave}" />
                                                                    <ContentControl Grid.Column="2" Style="{StaticResource ChipEstado}">
                                                                        <TextBlock Text="{Binding Estado}" FontSize="9" FontWeight="SemiBold" />
                                                                    </ContentControl>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding TieneFilas}" Value="False" />
                                                                        <Condition Binding="{Binding EstaCargando}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding Mensaje}" FontSize="11" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource BrochaTextoSuave}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                </Grid>

                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding EsReporte}" Value="True" />
                                                                        <Condition Binding="{Binding EstaCargando}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="150" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding ResumenReporte}" FontSize="10"
                                                               Foreground="{StaticResource BrochaTextoSuave}" />
                                                    <controles:GraficoLineasVentas Grid.Row="1"
                                                                                   Datos="{Binding Reporte.VentasDiarias}"
                                                                                   Margin="0,4,0,0" />
                                                </Grid>
                                            </Grid>

                                            <Button Grid.Row="2" Content="Abrir módulo completo →" Tag="{Binding Nombre}" Click="AlAbrirModulo"
                                                    Style="{StaticResource BotonSecundario}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <controles:SkeletonCarga x:Name="SkeletonPanelVacio" Tipo="PanelVacio" MinHeight="180">
                            <controles:SkeletonCarga.Style><Style TargetType="controles:SkeletonCarga"><Style.Triggers>
                                <MultiDataTrigger><MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding TieneWidgetsInicio}" Value="False" />
                                    <Condition Binding="{Binding EstaCargandoInicio}" Value="True" />
                                </MultiDataTrigger.Conditions><Setter Property="Activo" Value="True" /></MultiDataTrigger>
                            </Style.Triggers></Style></controles:SkeletonCarga.Style>
                        </controles:SkeletonCarga>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,26,0,10">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TieneWidgetsInicio}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    <DataTrigger Binding="{Binding EstaCargandoInicio}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="54" Height="54" CornerRadius="18" Background="{StaticResource BrochaAcentoSuave}" HorizontalAlignment="Center">
                                <TextBlock Text="▦" FontSize="20" Foreground="{StaticResource BrochaAcento}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Personaliza tu Inicio" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="Arrastra módulos desde el menú o recupera las tarjetas iniciales."
                                       FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <Button x:Name="BotonRestaurarPanel" Content="Restaurar panel inicial" Click="AlRestaurarPanel"
                                    Style="{StaticResource BotonPrincipal}" Height="38" Padding="16,8" Margin="0,16,0,10" HorizontalAlignment="Center" />
                        </StackPanel>
                                <Border x:Name="AvisoDestinoWidgets"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        Background="{StaticResource BrochaAcentoSuave}"
                                        CornerRadius="14"
                                        Padding="14,9"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,10,0,0">
                                    <TextBlock Text="Suelta aquí para agregar la sección"
                                               Foreground="{StaticResource BrochaAcento}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.RowSpan="3" Margin="0,27,0,0" MinHeight="520">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Tarjeta}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsModuloPendiente}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EstaCargandoModulo}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="310" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource BrochaAcentoSuave}">
                                <TextBlock Text="{Binding ModuloSeleccionado.Inicial}" Foreground="{StaticResource BrochaAcento}"
                                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,1,20,0">
                                <TextBlock Text="{Binding ModuloSeleccionado.Nombre}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock
                                           Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" Margin="0,3,0,0" >
            <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding TotalModulo, StringFormat={}{0} registros en el módulo}" />
                <Style.Triggers><DataTrigger Binding="{Binding EstaCargandoModulo}" Value="True"><Setter Property="Text" Value="Consultando datos…" /></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#F2F3F1" BorderBrush="{StaticResource BrochaBorde}"
                                    BorderThickness="1" CornerRadius="16" Padding="14,5" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⌕" FontSize="18" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="12" Padding="2,8"
                                             ToolTip="Buscar dentro del módulo actual" />
                                </Grid>
                            </Border>
                            <Button Grid.Column="3" Content="{Binding AccionPrincipal}" Click="AlCrearRegistro"
                                    Margin="0,0,9,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeCrearRegistro}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="4" Content="{Binding TextoEditarRegistro}" Click="AlEditarRegistro" Margin="0,0,9,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeEditarRegistro}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="5" Content="Gestionar pedido" Click="AlGestionarPedido" Margin="0,0,9,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeGestionarPedido}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="6" Content="{Binding TextoAccionEstado}" Click="AlCambiarEstadoRegistro" Margin="0,0,9,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeCambiarEstadoRegistro}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="7" Content="Exportar CSV" Click="AlExportarReporte" Margin="0,0,9,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeExportarReporte}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel Grid.Column="8" Orientation="Horizontal">

                                <Button Content="Actualizar" Command="{Binding ActualizarModuloCommand}"
                                        Style="{StaticResource BotonPrincipal}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="2,12,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding MensajeModulo}" AutomationProperties.LiveSetting="Polite" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" x:Name="BotonVerImagen" Content="Ver imagen" Click="AlVerImagenProducto"
                                    IsEnabled="{Binding PuedeVerImagen}" Visibility="{Binding EsModuloProductos, Converter={StaticResource BoolAVisibilidad}}"
                                    ToolTip="Selecciona un producto para consultar su imagen" Style="{StaticResource BotonSecundario}" Padding="14,7" Margin="12,0,0,0"/>
                        </Grid>

                        <Border Grid.Row="2" Background="#F0F1EF" CornerRadius="13" Padding="14,11">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding EstaCargandoModulo}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1.65*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Encabezado1}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" />
                                <TextBlock Grid.Column="1" Text="{Binding Encabezado2}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Encabezado3}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="3" Text="{Binding Encabezado4}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="4" Text="{Binding Encabezado5}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="5" Text="ESTADO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <controles:SkeletonCarga x:Name="SkeletonModulo" Grid.Row="2" Grid.RowSpan="2" Tipo="Tabla" MinHeight="310" Activo="{Binding EstaCargandoModulo}" />
                        <Grid x:Name="ContenidoModulo" Grid.Row="3" Margin="0,4,0,0" controles:RevelacionContenido.Activa="True">
                            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding EstaCargandoModulo}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <ListBox ItemsSource="{Binding FilasModulo}" SelectedItem="{Binding FilaModuloSeleccionada}"
                                     Background="Transparent" BorderThickness="0"
                                     MaxHeight="510" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="AlDobleClicFila">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="FondoFila" Background="Transparent" CornerRadius="12">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="FondoFila" Property="Background" Value="#F3F4F2" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="FondoFila" Property="Background" Value="{StaticResource BrochaAcentoSuave}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrochaBorde}" BorderThickness="0,0,0,1" Padding="14,13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.15*" />
                                                    <ColumnDefinition Width="1.65*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Columna1}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Columna2}" FontSize="11" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Columna3}" FontSize="11" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Columna4}" FontSize="11" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{Binding Columna5}" FontSize="11" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                <ContentControl Grid.Column="5" Style="{StaticResource ChipEstado}" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Estado}" FontSize="9" FontWeight="SemiBold" />
                                                </ContentControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TieneFilasModulo}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="54" Height="54" CornerRadius="18" Background="{StaticResource BrochaAcentoSuave}">
                                    <TextBlock Text="∅" FontSize="18" Foreground="{StaticResource BrochaAcento}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No hay registros para mostrar" FontSize="13" FontWeight="SemiBold" Margin="0,13,0,0" />
                                <TextBlock Text="Actualiza el módulo o cambia el texto de búsqueda."
                                           FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border x:Name="BarraEstado" Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="12" Margin="24,0,24,14" Padding="12,7">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#D7A23B"/>
                            <Style.Triggers><DataTrigger Binding="{Binding ConexionExitosa}" Value="True"><Setter Property="Fill" Value="#238B45"/></DataTrigger></Style.Triggers>
                        </Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding EstadoConexion}" ToolTip="{Binding EstadoConexion}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding NombreTienda}" FontSize="11" Margin="12,0" Foreground="{StaticResource BrochaTextoSuave}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MensajeActualizacion}" MaxWidth="180" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding VersionActual, StringFormat=v{0}}" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="{Binding TextoBotonActualizacion}" Command="{Binding BuscarActualizacionesCommand}" Style="{StaticResource BotonSecundario}" Padding="10,6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
