<Window x:Class="Cogana.Admin.Escritorio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controles="clr-namespace:Cogana.Admin.Escritorio.Controles"
        mc:Ignorable="d"
        Title="Cogana Admin"
        Height="850"
        Width="1440"
        MinHeight="720"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrochaFondo}">

    <Window.Resources>
        <!-- Acceso directo del carril lateral: resalta el módulo activo -->
        <Style x:Key="BotonAccesoRapido" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CFD2CF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra compacta inspirada en las referencias -->
        <Border Margin="16,18,0,18"
                Background="{StaticResource BrochaNegro}"
                CornerRadius="28">
            <Grid Margin="0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="44" Height="44" CornerRadius="15" Background="White">
                    <TextBlock Text="C" Foreground="{StaticResource BrochaNegro}"
                               FontSize="22" FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Button Tag="Inicio" Content="⌂" FontSize="21" Click="AlAbrirModulo" ToolTip="Inicio">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonAccesoRapido}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModuloSeleccionado.Nombre}" Value="Inicio">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="{StaticResource BrochaNegro}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="Productos" Content="▦" FontSize="19" Click="AlAbrirModulo" ToolTip="Productos">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonAccesoRapido}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModuloSeleccionado.Nombre}" Value="Productos">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="{StaticResource BrochaNegro}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="Pedidos" Content="◇" FontSize="20" Click="AlAbrirModulo" ToolTip="Pedidos">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonAccesoRapido}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModuloSeleccionado.Nombre}" Value="Pedidos">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="{StaticResource BrochaNegro}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="Promociones" Content="%" FontSize="16" FontWeight="SemiBold" Click="AlAbrirModulo" ToolTip="Promociones">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonAccesoRapido}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModuloSeleccionado.Nombre}" Value="Promociones">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="{StaticResource BrochaNegro}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Button Grid.Row="2" Tag="Configuración" Content="⚙" FontSize="19" Click="AlAbrirModulo" ToolTip="Configuración">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonAccesoRapido}">
                            <Setter Property="Background" Value="#252826" />
                            <Setter Property="Foreground" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModuloSeleccionado.Nombre}" Value="Configuración">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="{StaticResource BrochaNegro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Menú principal -->
        <Border Grid.Column="1"
                Margin="10,18,0,18"
                Background="{StaticResource BrochaSuperficie}"
                BorderBrush="#10000000"
                BorderThickness="1"
                CornerRadius="28"
                Padding="18,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="✦  COGANA" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Administración" Foreground="{StaticResource BrochaTextoSuave}"
                               FontSize="12" Margin="25,3,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Height="1" Background="{StaticResource BrochaBorde}" Margin="0,20,0,13" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Modulos}"
                         SelectedItem="{Binding ModuloSeleccionado}"
                         SelectionChanged="AlCambiarModulo"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource BrochaTexto}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="FondoOpcion"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="16"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FondoOpcion" Property="Background" Value="#14000000" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="FondoOpcion" Property="Background" Value="{StaticResource BrochaNegro}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="27" Height="27" CornerRadius="9"
                                        Background="#12000000">
                                    <TextBlock Text="{Binding Inicial}" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontSize="13"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                           VerticalAlignment="Center" Margin="7,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Background="White" CornerRadius="18" Padding="14" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BrochaAcentoSuave}">
                            <TextBlock Text="{Binding InicialesUsuario}" Foreground="{StaticResource BrochaAcento}" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CorreoUsuario}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RolUsuario}" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Área de trabajo -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="30,24,30,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding ModuloSeleccionado.Nombre}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="34" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding FechaActual}" FontSize="13" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock Text="  •  " FontSize="13" Foreground="#A2A7A3" />
                            <TextBlock Text="{Binding ModuloSeleccionado.Descripcion}" FontSize="13" Foreground="{StaticResource BrochaTextoSuave}" />
                        </StackPanel>
                    </StackPanel>

                    <ProgressBar Grid.Column="1" Style="{StaticResource IndicadorCarga}"
                                 Margin="0,0,12,0"
                                 Visibility="{Binding EstaCargandoInicio, Converter={StaticResource BoolAVisibilidad}}" />

                    <Button Grid.Column="2" Content="Actualizar resumen"
                            Command="{Binding VerificarConexionCommand}"
                            Style="{StaticResource BotonPrincipal}" />
                </Grid>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,27,0,18">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsModuloInicio}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>
                    <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Productos activos" FontSize="12" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock Text="{Binding ProductosActivos}" FontSize="31" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding CategoriasActivas, StringFormat={}{0} categorías activas}" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Lotes por vencer" FontSize="12" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock Text="{Binding LotesPorVencer}" FontSize="31" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Próximos 30 días" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Pedidos pendientes" FontSize="12" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock Text="{Binding PedidosPendientes}" FontSize="31" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Requieren atención" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BrochaNegro}" CornerRadius="22" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Estado de tienda" FontSize="12" Foreground="#BFC4C0" />
                            <TextBlock Text="{Binding EstadoTienda}" FontSize="23" FontWeight="SemiBold" Foreground="White" Margin="0,9,0,0" />
                            <TextBlock Text="{Binding DetalleEstadoTienda}" FontSize="11" Foreground="#BFC4C0" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>


                <Border Grid.Row="2"
                        x:Name="ZonaWidgets">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="22" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsModuloInicio}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Secciones del panel" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Arrastra una opción de la bandeja al panel o haz clic para agregarla. Reordena las tarjetas desde su cabecera y quítalas con ✕."
                                           FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{StaticResource BrochaSuperficie}"
                                BorderBrush="{StaticResource BrochaBorde}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,12"
                                Margin="0,14,0,0">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding ModulosDisponiblesParaAgregar}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Nombre}" Tag="{Binding Nombre}"
                                                    Click="AlAgregarDesdeSelector"
                                                    PreviewMouseLeftButtonDown="AlPresionarOpcionPanel"
                                                    PreviewMouseMove="AlMoverOpcionPanel"
                                                    Cursor="Hand"
                                                    ToolTip="Arrastra al panel o haz clic para agregar"
                                                    Style="{StaticResource BotonSecundario}" Margin="0,0,8,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Todas las secciones disponibles ya están en el panel."
                                           HorizontalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource BrochaTextoSuave}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HayModulosParaAgregar}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                x:Name="ZonaDestinoWidgets"
                                Margin="0,16,0,0"
                                MinHeight="120"
                                AllowDrop="True"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="20"
                                PreviewDragOver="AlArrastrarModuloSobrePanel"
                                PreviewDragLeave="AlSalirArrastreModulo"
                                PreviewDrop="AlSoltarModuloEnPanel">
                            <Grid>
                        <ItemsControl ItemsSource="{Binding WidgetsInicio}"
                                      x:Name="TableroWidgets" AllowDrop="True"
                                      DragOver="AlArrastrarTarjetaSobreTablero"
                                      DragLeave="AlSalirArrastreTarjeta"
                                      Drop="AlSoltarTarjetaEnTablero">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="460" Style="{StaticResource Tarjeta}" Padding="20" Margin="0,0,12,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Background="Transparent" Cursor="SizeAll"
                                                  MouseMove="AlMoverTarjetaParaOrdenar"
                                                  ToolTip="Arrastra para reordenar esta sección">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource BrochaAcentoSuave}">
                                                    <TextBlock Text="{Binding Inicial}" Foreground="{StaticResource BrochaAcento}"
                                                               FontSize="12" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Total, StringFormat={}{0} registros en Supabase}"
                                                               FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="✕" Click="AlQuitarWidget"
                                                        ToolTip="Quitar sección del panel"
                                                        Style="{StaticResource BotonSecundario}" Padding="10,5" FontSize="11" />
                                            </Grid>

                                            <Grid Grid.Row="1" MinHeight="150" Margin="0,12,0,0">
                                                <ProgressBar Style="{StaticResource IndicadorCarga}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisibilidad}}" />
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsReporte}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                <ItemsControl ItemsSource="{Binding Filas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BrochaBorde}" BorderThickness="0,0,0,1" Padding="2,9">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="125" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Columna1}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Columna2}" FontSize="11" Margin="8,0,8,0"
                                                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrochaTextoSuave}" />
                                                                    <ContentControl Grid.Column="2" Style="{StaticResource ChipEstado}">
                                                                        <TextBlock Text="{Binding Estado}" FontSize="9" FontWeight="SemiBold" />
                                                                    </ContentControl>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding TieneFilas}" Value="False" />
                                                                        <Condition Binding="{Binding EstaCargando}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding Mensaje}" FontSize="11" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource BrochaTextoSuave}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                </Grid>

                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding EsReporte}" Value="True" />
                                                                        <Condition Binding="{Binding EstaCargando}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="150" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding ResumenReporte}" FontSize="10"
                                                               Foreground="{StaticResource BrochaTextoSuave}" />
                                                    <controles:GraficoLineasVentas Grid.Row="1"
                                                                                   Datos="{Binding Reporte.VentasDiarias}"
                                                                                   Margin="0,4,0,0" />
                                                </Grid>
                                            </Grid>

                                            <Button Grid.Row="2" Content="Abrir módulo completo →" Tag="{Binding Nombre}" Click="AlAbrirModulo"
                                                    Style="{StaticResource BotonSecundario}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,26,0,10">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TieneWidgetsInicio}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="54" Height="54" CornerRadius="18" Background="{StaticResource BrochaAcentoSuave}" HorizontalAlignment="Center">
                                <TextBlock Text="▦" FontSize="20" Foreground="{StaticResource BrochaAcento}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="El panel está vacío" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="Arrastra aquí una opción de la bandeja superior o haz clic para agregarla."
                                       FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                                <Border x:Name="AvisoDestinoWidgets"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        Background="{StaticResource BrochaAcentoSuave}"
                                        CornerRadius="14"
                                        Padding="14,9"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,10,0,0">
                                    <TextBlock Text="Suelta aquí para agregar la sección"
                                               Foreground="{StaticResource BrochaAcento}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Margin="0,16,0,0" Padding="18,13">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Tarjeta}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsModuloInicio}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="#D7A23B" VerticalAlignment="Center" />
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EstadoConexion}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock FontSize="11" Foreground="{StaticResource BrochaTextoSuave}">
                                    <Run Text="{Binding NombreTienda, Mode=OneWay}" /><Run Text="  •  " /><Run Text="{Binding DistritoTienda, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding MensajeActualizacion}" FontSize="11"
                                   Foreground="{StaticResource BrochaTextoSuave}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" MaxWidth="430" TextWrapping="Wrap" TextAlignment="Right" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionActual, StringFormat=v{0}}" FontSize="11"
                                       Foreground="{StaticResource BrochaTextoSuave}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="{Binding TextoBotonActualizacion}" Command="{Binding BuscarActualizacionesCommand}"
                                    Style="{StaticResource BotonSecundario}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.RowSpan="3" Margin="0,27,0,0" MinHeight="520">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Tarjeta}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsModuloPendiente}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="310" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource BrochaAcentoSuave}">
                                <TextBlock Text="{Binding ModuloSeleccionado.Inicial}" Foreground="{StaticResource BrochaAcento}"
                                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,1,20,0">
                                <TextBlock Text="{Binding ModuloSeleccionado.Nombre}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TotalModulo, StringFormat={}{0} registros en el módulo}"
                                           Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="#F2F3F1" BorderBrush="{StaticResource BrochaBorde}"
                                    BorderThickness="1" CornerRadius="16" Padding="14,5" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⌕" FontSize="18" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="12" Padding="2,8"
                                             ToolTip="Buscar dentro del módulo actual" />
                                </Grid>
                            </Border>
                            <Button Grid.Column="3" Content="{Binding AccionPrincipal}" Click="AlCrearRegistro"
                                    Margin="0,0,9,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeCrearRegistro}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="4" Content="{Binding TextoEditarRegistro}" Click="AlEditarRegistro" Margin="0,0,9,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeEditarRegistro}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="5" Content="Gestionar pedido" Click="AlGestionarPedido" Margin="0,0,9,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeGestionarPedido}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="6" Content="{Binding TextoAccionEstado}" Click="AlCambiarEstadoRegistro" Margin="0,0,9,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeCambiarEstadoRegistro}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="7" Content="Exportar CSV" Click="AlExportarReporte" Margin="0,0,9,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeExportarReporte}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel Grid.Column="8" Orientation="Horizontal">
                                <ProgressBar Style="{StaticResource IndicadorCarga}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"
                                             Visibility="{Binding EstaCargandoModulo, Converter={StaticResource BoolAVisibilidad}}" />
                                <Button Content="Actualizar" Command="{Binding ActualizarModuloCommand}"
                                        Style="{StaticResource BotonPrincipal}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding MensajeModulo}" FontSize="11"
                                   Foreground="{StaticResource BrochaTextoSuave}" Margin="2,14,0,13" />

                        <Border Grid.Row="2" Background="#F0F1EF" CornerRadius="13" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1.65*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Encabezado1}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" />
                                <TextBlock Grid.Column="1" Text="{Binding Encabezado2}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Encabezado3}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="3" Text="{Binding Encabezado4}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="4" Text="{Binding Encabezado5}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="5" Text="ESTADO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,4,0,0">
                            <ListBox ItemsSource="{Binding FilasModulo}" SelectedItem="{Binding FilaModuloSeleccionada}"
                                     Background="Transparent" BorderThickness="0"
                                     MaxHeight="510" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="AlDobleClicFila">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="FondoFila" Background="Transparent" CornerRadius="12">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="FondoFila" Property="Background" Value="#F3F4F2" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="FondoFila" Property="Background" Value="{StaticResource BrochaAcentoSuave}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrochaBorde}" BorderThickness="0,0,0,1" Padding="14,13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.15*" />
                                                    <ColumnDefinition Width="1.65*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Columna1}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Columna2}" FontSize="11" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Columna3}" FontSize="11" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Columna4}" FontSize="11" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{Binding Columna5}" FontSize="11" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                <ContentControl Grid.Column="5" Style="{StaticResource ChipEstado}" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Estado}" FontSize="9" FontWeight="SemiBold" />
                                                </ContentControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TieneFilasModulo}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="54" Height="54" CornerRadius="18" Background="{StaticResource BrochaAcentoSuave}">
                                    <TextBlock Text="∅" FontSize="18" Foreground="{StaticResource BrochaAcento}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No hay registros para mostrar" FontSize="13" FontWeight="SemiBold" Margin="0,13,0,0" />
                                <TextBlock Text="Actualiza el módulo o cambia el texto de búsqueda."
                                           FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

    </Grid>
</Window>
