<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaOperacionPedido"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Atender pedido"
        Width="960" Height="720" MinWidth="700" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrochaSuperficie}">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource CampoFormulario}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource SelectorFormulario}"/>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="14,10"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrochaBorde}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoAccesible}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="Titulo" Text="Atender pedido" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="Resumen" Text="Consultando el pedido…" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <TabControl x:Name="Pasos" Grid.Row="1" AutomationProperties.Name="Operaciones del pedido">
            <TabItem Header="Pagos">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                    <TextBlock Text="Comprueba el ingreso real antes de confirmar. Rechazar un cobro cancela el pedido y libera sus reservas." TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Label Content="Transacción pendiente" Target="{Binding ElementName=Pago}"/>
                    <ComboBox x:Name="Pago" DisplayMemberPath="Descripcion" SelectionChanged="AlSeleccionarPago" AutomationProperties.Name="Transacción pendiente"/>
                    <Label Content="Referencia verificada o motivo de rechazo" Target="{Binding ElementName=Referencia}" Margin="0,14,0,0"/>
                    <TextBox x:Name="Referencia" MaxLength="100" AutomationProperties.Name="Referencia verificada o motivo de rechazo"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="ConfirmarPago" Content="Confirmar cobro recibido" Click="AlConfirmarPago" Style="{StaticResource BotonPrincipal}" Margin="0,0,8,8"/>
                        <Button x:Name="LiquidarDiferencia" Content="Registrar diferencia liquidada" Click="AlLiquidar" Style="{StaticResource BotonSecundario}" Margin="0,0,8,8"/>
                        <Button x:Name="RechazarPago" Content="Rechazar cobro" Click="AlRechazarPago" Style="{StaticResource BotonSecundario}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Text="Las diferencias y reembolsos se registran después de realizar el movimiento de dinero correspondiente." TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Preparación">
                <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Introduce la cantidad preparada de cada artículo en su unidad base. El servidor calcula el importe, consume el inventario y genera las diferencias de pago. Esta confirmación se realiza una sola vez." TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <DataGrid Grid.Row="1" x:Name="Cantidades" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Cantidades preparadas por artículo" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Unidad base" Binding="{Binding Unidad}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Cantidad preparada" Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" x:Name="FinalizarPreparacion" Content="Confirmar preparación" Click="AlPreparar" HorizontalAlignment="Right" Style="{StaticResource BotonPrincipal}" Margin="0,16,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Sustituciones">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelSustituciones" Margin="16">
                    <TextBlock Text="Propón un reemplazo antes de confirmar la preparación. La política elegida por el cliente determina si se acepta automáticamente o requiere respuesta. Registra una decisión solo si el cliente la confirmó." TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Label Content="Artículo a sustituir" Target="{Binding ElementName=ArticuloSustitucion}"/>
                    <ComboBox x:Name="ArticuloSustitucion" DisplayMemberPath="Producto" AutomationProperties.Name="Artículo a sustituir"/>
                    <Label Content="Buscar presentación de reemplazo por nombre" Target="{Binding ElementName=BusquedaReemplazo}"/>
                    <DockPanel><Button DockPanel.Dock="Right" Content="Buscar" Click="AlBuscarReemplazo" Style="{StaticResource BotonSecundario}" Margin="8,0,0,0"/><TextBox x:Name="BusquedaReemplazo" MaxLength="100" AutomationProperties.Name="Nombre de presentación de reemplazo"/></DockPanel>
                    <ComboBox x:Name="Reemplazo" DisplayMemberPath="Descripcion" AutomationProperties.Name="Presentación de reemplazo" Margin="0,8,0,0"/>
                    <TextBlock Text="Se muestran hasta 50 coincidencias; precisa el nombre para encontrar otra presentación." TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Label Content="Cantidad propuesta en la unidad base del reemplazo" Target="{Binding ElementName=CantidadReemplazo}"/>
                    <TextBox x:Name="CantidadReemplazo" AutomationProperties.Name="Cantidad base propuesta"/>
                    <Label Content="Plazo de respuesta en minutos (1–1440)" Target="{Binding ElementName=PlazoReemplazo}"/>
                    <TextBox x:Name="PlazoReemplazo" Text="30" AutomationProperties.Name="Plazo de respuesta en minutos"/>
                    <Button Content="Proponer reemplazo" Click="AlProponer" Style="{StaticResource BotonPrincipal}" HorizontalAlignment="Left" Margin="0,12,0,20"/>
                    <Label Content="Propuesta pendiente" Target="{Binding ElementName=Sustitucion}"/>
                    <ComboBox x:Name="Sustitucion" DisplayMemberPath="Descripcion" AutomationProperties.Name="Propuesta de sustitución pendiente"/>
                    <WrapPanel Margin="0,12,0,0"><Button Content="Registrar aceptación del cliente" Click="AlAceptarSustitucion" Style="{StaticResource BotonSecundario}" Margin="0,0,8,8"/><Button Content="Registrar rechazo del cliente" Click="AlRechazarSustitucion" Style="{StaticResource BotonSecundario}" Margin="0,0,8,8"/></WrapPanel>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Entrega o recojo">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                    <TextBlock Text="Para delivery, asigna al personal responsable cuando el pedido esté listo. Para cerrar, solicita al cliente el código de su pedido." TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <StackPanel x:Name="SeccionRepartidor">
                    <Label Content="Personal responsable del delivery" Target="{Binding ElementName=Repartidor}"/>
                    <ComboBox x:Name="Repartidor" DisplayMemberPath="NombreCompleto" AutomationProperties.Name="Personal responsable del delivery"/>
                    <Button x:Name="AsignarRepartidor" Content="Asignar repartidor" Click="AlAsignar" HorizontalAlignment="Left" Style="{StaticResource BotonSecundario}" Margin="0,12,0,20"/>
                    </StackPanel>
                    <Label Content="Código que proporciona el cliente" Target="{Binding ElementName=Codigo}"/>
                    <PasswordBox x:Name="Codigo" MaxLength="40" AutomationProperties.Name="Código de recojo o entrega del cliente"/>
                    <Label x:Name="EtiquetaDestinatario" Content="Nombre de quien recibe (delivery)" Target="{Binding ElementName=Destinatario}" Margin="0,14,0,0"/>
                    <TextBox x:Name="Destinatario" MaxLength="150" AutomationProperties.Name="Nombre de quien recibe la entrega"/>
                    <Button x:Name="CompletarPedido" Content="Verificar código y completar" Click="AlCompletar" HorizontalAlignment="Left" Style="{StaticResource BotonPrincipal}" Margin="0,16,0,0"/>
                    <TextBlock Text="En recojo con efectivo, completar confirma también el cobro del importe final. Verifica que lo hayas recibido." TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Mensaje" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="Actualizar" Grid.Column="1" Content="Actualizar pedido" Click="AlActualizar" Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"/>
            <Button x:Name="Cerrar" Grid.Column="2" Content="Volver al detalle" Click="AlCerrar" Style="{StaticResource BotonPrincipal}"/>
        </Grid>
    </Grid>
</Window>
