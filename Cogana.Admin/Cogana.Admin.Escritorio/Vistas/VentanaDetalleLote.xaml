<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaDetalleLote"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle del lote"
        Width="900"
        Height="780"
        MinWidth="820"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BrochaFondo}">
    <Grid Margin="22">
        <Border Background="{StaticResource BrochaSuperficie}"
                BorderBrush="#12000000" BorderThickness="1"
                CornerRadius="28" Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource BrochaNegro}">
                        <TextBlock Text="L" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TituloLote" Text="Cargando lote..."
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="25" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtituloLote" Text="Detalle, movimientos y ajuste de inventario"
                                   Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="EtiquetaEstado"
                            Background="{StaticResource BrochaAcentoSuave}"
                            CornerRadius="13" Padding="13,7" VerticalAlignment="Center">
                        <TextBlock x:Name="TextoEstado" Text="Consultando"
                                   Foreground="{StaticResource BrochaAcento}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="3" Margin="0,22,0,18">
                    <Border Style="{StaticResource Tarjeta}" Padding="17" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Existencia disponible" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock x:Name="CantidadDisponible" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" Padding="17" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Fecha de vencimiento" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock x:Name="FechaVencimiento" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BrochaNegro}" CornerRadius="22" Padding="17" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Proveedor" FontSize="10" Foreground="#BFC4C0" />
                            <TextBlock x:Name="NombreProveedor" Text="—" FontSize="16" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" BorderBrush="{StaticResource BrochaBorde}" BorderThickness="1"
                            CornerRadius="20" Padding="18" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Historial de movimientos" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" x:Name="ResumenMovimientos" Text="Consultando operaciones..."
                                       FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,12" />
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#F0F1EF" CornerRadius="11" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="115" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="FECHA" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="1" Text="TIPO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="2" Text="CAMBIO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="3" Text="MOTIVO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" />
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1" x:Name="ListaMovimientos" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BrochaBorde}" BorderThickness="0,0,0,1" Padding="10,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="116" />
                                                        <ColumnDefinition Width="115" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Fecha}" FontSize="10" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TipoVisible}" FontSize="10" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CambioVisible}" FontSize="10" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Motivo, TargetNullValue=Sin detalle}" FontSize="10"
                                                               Foreground="{StaticResource BrochaTextoSuave}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,0,6,0">
                            <Border Background="White" BorderBrush="{StaticResource BrochaBorde}" BorderThickness="1"
                                    CornerRadius="20" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Información del lote" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Recibido" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,13,0,0" />
                                    <TextBlock x:Name="FechaRecepcion" Text="—" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    <TextBlock Text="Notas" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,12,0,0" />
                                    <TextBlock x:Name="NotasLote" Text="Sin notas" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BrochaAcentoSuave}" CornerRadius="20" Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ajuste por conteo físico" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Ingresa la cantidad total encontrada. Se registrará la diferencia en el historial."
                                               Foreground="{StaticResource BrochaAcento}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="Cantidad contada *" FontSize="10" FontWeight="SemiBold" Margin="0,14,0,0" />
                                    <TextBox x:Name="CantidadContada" Style="{StaticResource CampoFormulario}" />
                                    <TextBlock Text="Motivo del ajuste *" FontSize="10" FontWeight="SemiBold" Margin="0,13,0,0" />
                                    <TextBox x:Name="MotivoAjuste" Style="{StaticResource CampoFormulario}" Height="62"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                                    <Button x:Name="BotonAjustar" Content="Registrar ajuste" Click="AlAjustar"
                                            Style="{StaticResource BotonPrincipal}" Margin="0,14,0,0" IsEnabled="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MensajeVentana" Foreground="#9A443F" FontSize="11"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="1,0,14,0" />
                    <Button Grid.Column="1" Content="Cerrar" Click="AlCerrar" Style="{StaticResource BotonSecundario}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
