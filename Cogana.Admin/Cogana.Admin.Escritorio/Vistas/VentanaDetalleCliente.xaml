<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaDetalleCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ficha del cliente"
        Width="980"
        Height="790"
        MinWidth="900"
        MinHeight="710"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BrochaFondo}">
    <Grid Margin="22">
        <Border Background="{StaticResource BrochaSuperficie}" BorderBrush="#12000000"
                BorderThickness="1" CornerRadius="28" Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource BrochaNegro}">
                        <TextBlock x:Name="InicialCliente" Text="CL" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NombreCliente" Text="Cargando cliente..."
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="25" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="TelefonoCliente" Text="—" Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" />
                            <TextBlock Text="  ·  " Foreground="#A2A7A3" FontSize="11" />
                            <TextBlock x:Name="CorreoCliente" Text="—" Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="EtiquetaEstado" Background="{StaticResource BrochaAcentoSuave}"
                            CornerRadius="13" Padding="13,7" VerticalAlignment="Center">
                        <TextBlock x:Name="TextoEstado" Text="Consultando" Foreground="{StaticResource BrochaAcento}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,18">
                    <Border Style="{StaticResource Tarjeta}" Padding="16" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="Pedidos registrados" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock x:Name="TotalPedidos" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" Padding="16" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="Total acumulado" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock x:Name="TotalAcumulado" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" Padding="16" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="Direcciones" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock x:Name="TotalDirecciones" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BrochaNegro}" CornerRadius="22" Padding="16" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Cliente desde" FontSize="10" Foreground="#BFC4C0" />
                            <TextBlock x:Name="ClienteDesde" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Background="White" BorderBrush="{StaticResource BrochaBorde}" BorderThickness="1"
                                    CornerRadius="20" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Cuenta y preferencias" FontSize="16" FontWeight="SemiBold" />
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Teléfono verificado" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="1" x:Name="TelefonoVerificado" Text="—" FontSize="10" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Avisos de pedidos" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="1" x:Name="AvisosPedidos" Text="—" FontSize="10" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Avisos de promociones" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="1" x:Name="AvisosPromociones" Text="—" FontSize="10" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Consentimiento comercial" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="1" x:Name="ConsentimientoMarketing" Text="—" FontSize="10" FontWeight="SemiBold" />
                                    </Grid>
                                    <TextBlock Text="Sustitución predeterminada" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,11,0,0" />
                                    <TextBlock x:Name="PreferenciaSustitucion" Text="—" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    <TextBlock x:Name="RestriccionEfectivo" Text="" Foreground="#9A443F" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="{StaticResource BrochaBorde}" BorderThickness="1"
                                    CornerRadius="20" Padding="18" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Direcciones" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ResumenDirecciones" Text="Consultando direcciones..."
                                                   FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,10" />
                                    </StackPanel>
                                    <ListBox Grid.Row="1" x:Name="ListaDirecciones" Background="Transparent" BorderThickness="0"
                                             MaxHeight="270" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BrochaBorde}" BorderThickness="0,0,0,1" Padding="2,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Titulo}" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Ubicacion}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding ReferenciaVisible}" FontSize="9" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BrochaBorde}" BorderThickness="1"
                            CornerRadius="20" Padding="18" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Historial de pedidos" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" x:Name="ResumenPedidos" Text="Consultando pedidos..."
                                       FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,0,12" />
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#F0F1EF" CornerRadius="11" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="PEDIDO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="1" Text="FECHA" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="2" Text="ESTADO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="3" Text="PAGO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" />
                                        <TextBlock Grid.Column="4" Text="TOTAL" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrochaTextoSuave}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1" x:Name="ListaPedidos" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BrochaBorde}" BorderThickness="0,0,0,1" Padding="10,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="95" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Numero}" FontSize="10" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Entrega}" FontSize="9" Foreground="{StaticResource BrochaTextoSuave}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Fecha}" FontSize="9" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Estado}" FontSize="10" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding EstadoPago}" FontSize="9" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Total}" FontSize="10" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MensajeVentana" Text="Los datos personales se muestran solo para la operación de la tienda."
                               Foreground="{StaticResource BrochaTextoSuave}" FontSize="10" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Cerrar" Click="AlCerrar" Style="{StaticResource BotonPrincipal}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
