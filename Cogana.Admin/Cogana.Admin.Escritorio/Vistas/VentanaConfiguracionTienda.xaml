<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaConfiguracionTienda"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de la tienda"
        Width="1040" Height="780" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BrochaFondo}">
    <Window.Resources>
        <Style x:Key="PestanaConfiguracion" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource BrochaTextoSuave}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="FondoPestana" Background="Transparent" CornerRadius="13"
                                Padding="14,8" Margin="0,0,6,0">
                            <ContentPresenter x:Name="TextoPestana" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoPestana" Property="Background" Value="#ECEEEC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FondoPestana" Property="Background" Value="{StaticResource BrochaNegro}" />
                                <Setter TargetName="TextoPestana" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EncabezadoTablaConfiguracion" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F3F1" />
            <Setter Property="Foreground" Value="{StaticResource BrochaTextoSuave}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrochaBorde}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CeldaTablaConfiguracion" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FilaTablaConfiguracion" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#ECEDEA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{StaticResource BrochaTexto}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F7F5" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrochaAcentoSuave}" />
                    <Setter Property="Foreground" Value="{StaticResource BrochaTexto}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TablaConfiguracion" TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrochaBorde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource EncabezadoTablaConfiguracion}" />
            <Setter Property="CellStyle" Value="{StaticResource CeldaTablaConfiguracion}" />
            <Setter Property="RowStyle" Value="{StaticResource FilaTablaConfiguracion}" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Border Background="{StaticResource BrochaSuperficie}"
                BorderBrush="#12000000" BorderThickness="1"
                CornerRadius="28" Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource BrochaNegro}">
                        <TextBlock Text="CO" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Configuración de la tienda"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Datos comerciales, atención, pagos y horarios compartidos con Cogana"
                                   Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource BrochaAcentoSuave}"
                            CornerRadius="13" Padding="13,7" VerticalAlignment="Center">
                        <TextBlock Text="SUPABASE" Foreground="{StaticResource BrochaAcento}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="#EEF4F1" CornerRadius="17" Padding="14" Margin="0,20,0,16">
                    <TextBlock Text="Los cambios se aplican a la misma tienda que usa la aplicación móvil. Solo propietarios y administradores activos pueden guardarlos."
                               FontSize="11" TextWrapping="Wrap" Foreground="#34473F" />
                </Border>

                <TabControl Grid.Row="2" x:Name="Pestanas" Background="Transparent" BorderThickness="0"
                            ItemContainerStyle="{StaticResource PestanaConfiguracion}">
                    <TabItem Header="Datos de tienda">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="10,18,16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Nombre de la tienda *" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="NombreTienda" Style="{StaticResource CampoFormulario}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nombre comercial *" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="NombreComercial" Style="{StaticResource CampoFormulario}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                    <TextBlock Text="Razón social" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="RazonSocial" Style="{StaticResource CampoFormulario}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                                    <TextBlock Text="RUC" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="Ruc" Style="{StaticResource CampoFormulario}" MaxLength="11" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                    <TextBlock Text="Dirección" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="Direccion" Style="{StaticResource CampoFormulario}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,16,0,0">
                                    <TextBlock Text="Distrito" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="Distrito" Style="{StaticResource CampoFormulario}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                    <TextBlock Text="Teléfono" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="Telefono" Style="{StaticResource CampoFormulario}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,16,0,0">
                                    <TextBlock Text="WhatsApp" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="Whatsapp" Style="{StaticResource CampoFormulario}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Atención y pagos">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,18,18,12">
                                <TextBlock Text="Canales de atención" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Debe quedar habilitado al menos un canal."
                                           Foreground="{StaticResource BrochaTextoSuave}" FontSize="10" Margin="0,3,0,12" />
                                <WrapPanel>
                                    <CheckBox x:Name="AceptaRecojo" Content="Recojo en tienda" Margin="0,0,28,12" FontSize="12" />
                                    <CheckBox x:Name="AceptaDelivery" Content="Delivery" Margin="0,0,28,12" FontSize="12" />
                                </WrapPanel>

                                <Separator Margin="0,10,0,18" />
                                <TextBlock Text="Métodos de pago" FontSize="14" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,13,0,0">
                                    <CheckBox x:Name="AceptaEfectivoRecojo" Content="Efectivo al recoger" Margin="0,0,28,12" FontSize="12" />
                                    <CheckBox x:Name="AceptaYape" Content="Yape" Margin="0,0,28,12" FontSize="12" />
                                    <CheckBox x:Name="AceptaPlin" Content="Plin" Margin="0,0,28,12" FontSize="12" />
                                    <CheckBox x:Name="AceptaTarjeta" Content="Tarjeta" Margin="0,0,28,12" FontSize="12" />
                                </WrapPanel>

                                <Separator Margin="0,10,0,18" />
                                <TextBlock Text="Tiempo predeterminado de preparación" FontSize="14" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBox x:Name="MinutosPreparacion" Width="120" Style="{StaticResource CampoFormulario}" />
                                    <TextBlock Text="minutos" VerticalAlignment="Center" Margin="10,7,0,0"
                                               Foreground="{StaticResource BrochaTextoSuave}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Horario semanal">
                        <Grid Margin="10,18,16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Usa el formato 08:00. Marca Cerrado cuando la tienda no atienda ese día."
                                       Foreground="{StaticResource BrochaTextoSuave}" FontSize="10" Margin="2,0,0,10" />
                            <DataGrid Grid.Row="1" x:Name="TablaHorarios" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      Style="{StaticResource TablaConfiguracion}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Día" Binding="{Binding NombreDia}" IsReadOnly="True" Width="*" />
                                    <DataGridTemplateColumn Header="Cerrado" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Cerrado, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Apertura" Binding="{Binding Apertura}" Width="150" />
                                    <DataGridTextColumn Header="Cierre" Binding="{Binding Cierre}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Fechas especiales">
                        <Grid Margin="10,18,16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Feriados, cierres o atención con horario distinto. Fecha: dd/MM/aaaa."
                                           Foreground="{StaticResource BrochaTextoSuave}" FontSize="10" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Agregar fecha" Click="AlAgregarExcepcion"
                                        Style="{StaticResource BotonSecundario}" Margin="8,0" />
                                <Button Grid.Column="2" Content="Quitar" Click="AlQuitarExcepcion"
                                        Style="{StaticResource BotonSecundario}" />
                            </Grid>
                            <DataGrid Grid.Row="1" x:Name="TablaExcepciones" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" Margin="0,12,0,0"
                                      Style="{StaticResource TablaConfiguracion}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                                    <DataGridTemplateColumn Header="Cerrado" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Cerrado, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Apertura" Binding="{Binding Apertura}" Width="110" />
                                    <DataGridTextColumn Header="Cierre" Binding="{Binding Cierre}" Width="110" />
                                    <DataGridTextColumn Header="Mensaje para clientes" Binding="{Binding Mensaje}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="Al guardar, esta lista reemplaza las fechas especiales registradas para la tienda."
                                       Foreground="{StaticResource BrochaTextoSuave}" FontSize="10" Margin="2,10,0,0" />
                        </Grid>
                    </TabItem>
                </TabControl>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MensajeFormulario" Foreground="#9A443F" FontSize="11"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="1,0,16,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cerrar" Click="AlCerrar" Style="{StaticResource BotonSecundario}" Margin="0,0,9,0" />
                        <Button x:Name="BotonGuardar" Content="Guardar configuración" Click="AlGuardar"
                                Style="{StaticResource BotonPrincipal}" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
