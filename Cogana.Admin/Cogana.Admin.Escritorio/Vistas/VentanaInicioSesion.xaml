<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaInicioSesion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso administrativo · Cogana"
        Width="1160"
        Height="740"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BrochaFondo}">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*" />
            <ColumnDefinition Width="0.92*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource BrochaNegro}" CornerRadius="30" Padding="42">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="16" Background="White">
                        <TextBlock Text="C" Foreground="{StaticResource BrochaNegro}" FontSize="24" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="13,2,0,0">
                        <TextBlock Text="COGANA" Foreground="White" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="ADMINISTRACIÓN DE ESCRITORIO" Foreground="#929894" FontSize="9" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="480" HorizontalAlignment="Left">
                    <Border Width="88" Height="30" CornerRadius="15" Background="#252826" HorizontalAlignment="Left">
                        <TextBlock Text="ACCESO SEGURO" Foreground="#CED3CF" FontSize="9" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Controla tu tienda desde un solo lugar."
                               Foreground="White"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="42"
                               FontWeight="SemiBold"
                               LineHeight="48"
                               TextWrapping="Wrap"
                               Margin="0,24,0,0" />
                    <TextBlock Text="Catálogo, inventario, pedidos y operación conectados con el mismo backend de Cogana."
                               Foreground="#AEB4B0"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Margin="0,18,28,0" />

                    <Grid Margin="0,34,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#202321" CornerRadius="20" Padding="18" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="01" Foreground="#77807A" FontSize="11" />
                                <TextBlock Text="Autenticación" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock Text="Supabase Auth" Foreground="#909792" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#202321" CornerRadius="20" Padding="18" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="02" Foreground="#77807A" FontSize="11" />
                                <TextBlock Text="Autorización" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock Text="Propietario o admin" Foreground="#909792" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="COGANA ADMIN  ·  WINDOWS DESKTOP"
                           Foreground="#666C68" FontSize="10" />
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource BrochaSuperficie}"
                BorderBrush="#10000000"
                BorderThickness="1"
                CornerRadius="30"
                Padding="54,45"
                Margin="12,0,0,0"
                KeyboardNavigation.TabNavigation="Continue">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Bienvenido" FontSize="31" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI" />
                    <TextBlock Text="Ingresa con una cuenta administrativa de Cogana."
                               FontSize="13" Foreground="{StaticResource BrochaTextoSuave}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Correo electrónico" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,8" />
                    <Border Background="White" BorderBrush="{StaticResource BrochaBorde}"
                            BorderThickness="1" CornerRadius="16" Padding="15,5">
                        <TextBox x:Name="CampoCorreo"
                                 Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="14" Padding="0,8" VerticalContentAlignment="Center"
                                 KeyDown="AlPresionarTeclaEnCampo"
                                 ToolTip="Correo asociado a la cuenta administrativa" />
                    </Border>

                    <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold" Margin="2,20,0,8" />
                    <Border Background="White" BorderBrush="{StaticResource BrochaBorde}"
                            BorderThickness="1" CornerRadius="16" Padding="15,5">
                        <PasswordBox x:Name="CampoContrasena"
                                     BorderThickness="0" Background="White"
                                     FontSize="14" Padding="0,8" VerticalContentAlignment="Center"
                                     KeyDown="AlPresionarTeclaEnCampo"
                                     ToolTip="Contraseña de Supabase Auth" />
                    </Border>

                    <TextBlock Text="{Binding Mensaje}"
                               Foreground="#9A443F" FontSize="12"
                               TextWrapping="Wrap" MinHeight="19" Margin="2,13,0,0" />

                    <Button x:Name="BotonInicioSesion"
                            Content="Entrar al panel"
                            Click="AlIniciarSesion"
                            IsDefault="True"
                            Height="48" Margin="0,10,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonPrincipal}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstaProcesando}" Value="True">
                                        <Setter Property="Content" Value="Ingresando..." />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Border Background="{StaticResource BrochaAcentoSuave}" CornerRadius="16" Padding="14" Margin="0,18,0,0">
                        <TextBlock Text="Solo las cuentas con membresía activa de propietario o administrador pueden ingresar."
                                   Foreground="#35594E" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="{StaticResource BrochaBorde}" Margin="0,0,0,16" />
                    <TextBlock Text="La sesión se mantiene únicamente mientras la aplicación está abierta."
                               FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
