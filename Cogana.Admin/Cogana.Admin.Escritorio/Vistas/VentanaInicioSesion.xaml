<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaInicioSesion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:Cogana.Admin.Escritorio.Controles"
        Title="Acceso administrativo · Cogana"
        Width="1080"
        Height="720"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#06090C"
        Foreground="White">

    <Window.Resources>

        <!-- Botón de acceso con esquinas suaves (radio 14 como el diseño) -->
        <Style x:Key="BotonEntrar" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0A0A0A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoBoton" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FondoBoton" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Deriva lenta de las capas de aurora -->
        <Storyboard x:Key="AnimacionAurora">
            <DoubleAnimation Storyboard.TargetName="LavadoVerdeT" Storyboard.TargetProperty="X"
                             From="-20" To="24" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LavadoVerdeT" Storyboard.TargetProperty="Y"
                             From="0" To="-18" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LavadoAzulT" Storyboard.TargetProperty="X"
                             From="18" To="-22" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LavadoAzulT" Storyboard.TargetProperty="Y"
                             From="14" To="-12" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LavadoVioletaT" Storyboard.TargetProperty="X"
                             From="-14" To="16" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LavadoVioletaT" Storyboard.TargetProperty="Y"
                             From="10" To="-14" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- Brillo giratorio sobre el borde de la tarjeta -->
        <Storyboard x:Key="AnimacionBrilloTarjeta">
            <DoubleAnimation Storyboard.TargetName="BrilloRotador" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:9" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- Entrada de la tarjeta al abrir la ventana -->
        <Storyboard x:Key="AnimacionEntrada">
            <DoubleAnimation Storyboard.TargetName="TarjetaT" Storyboard.TargetProperty="Y"
                             From="40" To="0" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TarjetaEscala" Storyboard.TargetProperty="ScaleX"
                             From="0.94" To="1" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TarjetaEscala" Storyboard.TargetProperty="ScaleY"
                             From="0.94" To="1" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TarjetaAcceso" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.7"/>
        </Storyboard>

        <!-- Detalles vivos: blob flotante y punto EN LÍNEA -->
        <Storyboard x:Key="AnimacionVida">
            <DoubleAnimation Storyboard.TargetName="BlobFlotanteT" Storyboard.TargetProperty="X"
                             From="0" To="-12" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="BlobFlotanteT" Storyboard.TargetProperty="Y"
                             From="0" To="16" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PuntoLinea" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.3" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- Decoración de la pantalla de carga (se inicia desde el código) -->
        <Storyboard x:Key="DecoracionCarga">
            <DoubleAnimation Storyboard.TargetName="Anillo1E" Storyboard.TargetProperty="ScaleX"
                             From="0.85" To="1.8" Duration="0:0:1.8" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Anillo1E" Storyboard.TargetProperty="ScaleY"
                             From="0.85" To="1.8" Duration="0:0:1.8" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Anillo1" Storyboard.TargetProperty="Opacity"
                             From="0.6" To="0" Duration="0:0:1.8" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="Anillo2E" Storyboard.TargetProperty="ScaleX"
                             From="0.85" To="1.8" Duration="0:0:2.2" BeginTime="0:0:0.3" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Anillo2E" Storyboard.TargetProperty="ScaleY"
                             From="0.85" To="1.8" Duration="0:0:2.2" BeginTime="0:0:0.3" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Anillo2" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="0" Duration="0:0:2.2" BeginTime="0:0:0.3" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="Anillo3E" Storyboard.TargetProperty="ScaleX"
                             From="0.85" To="1.8" Duration="0:0:2.6" BeginTime="0:0:0.6" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Anillo3E" Storyboard.TargetProperty="ScaleY"
                             From="0.85" To="1.8" Duration="0:0:2.6" BeginTime="0:0:0.6" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Anillo3" Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0" Duration="0:0:2.6" BeginTime="0:0:0.6" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="Halor" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:3.5" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Arcor" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="OrbE" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.04" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="OrbE" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.04" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="BrilloOrbe" Storyboard.TargetProperty="Opacity"
                             From="0.5" To="0.95" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="Punto1E" Storyboard.TargetProperty="ScaleX"
                             From="0.6" To="1.2" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Punto1E" Storyboard.TargetProperty="ScaleY"
                             From="0.6" To="1.2" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Punto2E" Storyboard.TargetProperty="ScaleX"
                             From="0.6" To="1.2" Duration="0:0:1.2" BeginTime="0:0:0.2" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Punto2E" Storyboard.TargetProperty="ScaleY"
                             From="0.6" To="1.2" Duration="0:0:1.2" BeginTime="0:0:0.2" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Punto3E" Storyboard.TargetProperty="ScaleX"
                             From="0.6" To="1.2" Duration="0:0:1.2" BeginTime="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Punto3E" Storyboard.TargetProperty="ScaleY"
                             From="0.6" To="1.2" Duration="0:0:1.2" BeginTime="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource AnimacionAurora}" />
            <BeginStoryboard Storyboard="{StaticResource AnimacionBrilloTarjeta}" />
            <BeginStoryboard Storyboard="{StaticResource AnimacionEntrada}" />
            <BeginStoryboard Storyboard="{StaticResource AnimacionVida}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="#06090C" MouseMove="AlMoverMouse" MouseLeave="AlSalirMouse">

        <!-- Capa 1: aurora viva -->
        <Grid IsHitTestVisible="False">
            <Ellipse Width="1250" Height="880" Margin="-380,-260,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.85">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8C0F462D" Offset="0"/>
                        <GradientStop Color="#460F462D" Offset="0.45"/>
                        <GradientStop Color="#000F462D" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="LavadoVerdeT"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Width="1050" Height="820" Margin="0,-120,-320,0"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.8">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#73082841" Offset="0"/>
                        <GradientStop Color="#39082841" Offset="0.45"/>
                        <GradientStop Color="#00082841" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="LavadoAzulT"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Width="900" Height="760" Margin="0,0,-150,-260"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.75">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#521E1937" Offset="0"/>
                        <GradientStop Color="#291E1937" Offset="0.5"/>
                        <GradientStop Color="#001E1937" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="LavadoVioletaT"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- Capa 2: rejilla tenue con máscara radial -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,0 L48,0 48,48 0,48 Z">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#04FFFFFF" Thickness="1"/>
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
            <Rectangle.OpacityMask>
                <RadialGradientBrush>
                    <GradientStop Color="#FF000000" Offset="0.35"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <!-- Capa 3: foco que sigue al mouse -->
        <Ellipse IsHitTestVisible="False" Width="960" Height="960" Opacity="0.9">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#0F4ADE80" Offset="0"/>
                    <GradientStop Color="#004ADE80" Offset="0.7"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="FocoMouseT"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- FASE LOGIN: la tarjeta se inclina hacia el mouse (rotación + sesgo + parallax) -->
        <Grid x:Name="PantallaLogin">
            <Border x:Name="TarjetaAcceso"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="424"
                    Background="#0BFFFFFF"
                    BorderThickness="1"
                    CornerRadius="26"
                    Opacity="0"
                    ClipToBounds="True"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="TarjetaRotacion"/>
                        <ScaleTransform x:Name="TarjetaEscala"/>
                        <SkewTransform x:Name="TarjetaSesgo"/>
                        <TranslateTransform x:Name="TarjetaT"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <!-- Anillo de luz que recorre el borde -->
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="BrilloRotador" CenterX="0.5" CenterY="0.5"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#594ADE80" Offset="0.12"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.3"/>
                        <GradientStop Color="#4D22D3EE" Offset="0.55"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.75"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <Grid ClipToBounds="True">

                    <!-- Blob flotante tras el contenido (superpuesto, no ocupa flujo) -->
                    <Ellipse Width="220" Height="220" Margin="0,-70,-50,0"
                             HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1A4ADE80" Offset="0"/>
                                <GradientStop Color="#004ADE80" Offset="0.7"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="BlobFlotanteT"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Brillo superior -->
                    <Border Height="1" Width="338" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#2EFFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Margin="38,36,38,38">

                        <!-- Logo y estado -->
                        <Grid Margin="0,0,0,28">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="13"
                                        BorderBrush="#404ADE80" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1C2620" Offset="0"/>
                                            <GradientStop Color="#14201A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="C" Foreground="White" FontSize="19" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="COGANA" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="ADMINISTRACIÓN" FontSize="10" Foreground="#52FFFFFF" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse Width="16" Height="16">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#804ADE80" Offset="0"/>
                                                <GradientStop Color="#004ADE80" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse x:Name="PuntoLinea" Width="7" Height="7" Fill="#4ADE80"/>
                                </Grid>
                                <TextBlock Text="EN LÍNEA" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#BF4ADE80" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Bienvenido de nuevo" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Ingresa tus credenciales para acceder al panel"
                                   FontSize="13" Foreground="#59FFFFFF" Margin="0,0,0,24"/>

                        <!-- Correo electrónico -->
                        <Grid Height="56" Margin="0,0,0,18">
                            <Border x:Name="BrilloCorreo" CornerRadius="18" Opacity="0" Margin="-8">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#2E4ADE80" Offset="0"/>
                                        <GradientStop Color="#004ADE80" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="FondoCorreo" CornerRadius="14" Background="#09FFFFFF"
                                    BorderBrush="#17FFFFFF" BorderThickness="1">
                                <TextBox x:Name="CampoCorreo"
                                         Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" CaretBrush="#4ADE80"
                                         FontSize="15" Margin="44,0,16,0" VerticalAlignment="Center"
                                         KeyDown="AlPresionarTeclaEnCampo"
                                         TextChanged="AlCambiarCampoTexto"
                                         GotKeyboardFocus="AlEnfocarCampo"
                                         LostKeyboardFocus="AlDesenfocarCampo"
                                         ToolTip="Correo asociado a la cuenta administrativa"/>
                            </Border>
                            <Path x:Name="IconoCorreo" Data="M3,5 H21 A2,2 0 0 1 23,7 V17 A2,2 0 0 1 21,19 H3 A2,2 0 0 1 1,17 V7 A2,2 0 0 1 3,5 Z M23,7 12,13 1,7"
                                  Stroke="#4DFFFFFF" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                                  Width="17" Height="17" Stretch="Uniform" IsHitTestVisible="False"/>
                            <TextBlock x:Name="EtiquetaCorreo" Text="Correo electrónico" FontSize="14"
                                       Foreground="#61FFFFFF" IsHitTestVisible="False"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,18,0,0"/>
                            <Border x:Name="LineaCorreo" Height="1.5" Width="0" CornerRadius="2"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0.9">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#004ADE80" Offset="0"/>
                                        <GradientStop Color="#B34ADE80" Offset="0.4"/>
                                        <GradientStop Color="#B322D3EE" Offset="0.6"/>
                                        <GradientStop Color="#004ADE80" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#4ADE80" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <!-- Contraseña -->
                        <Grid Height="56" Margin="0,0,0,4">
                            <Border x:Name="BrilloContrasena" CornerRadius="18" Opacity="0" Margin="-8">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#2E4ADE80" Offset="0"/>
                                        <GradientStop Color="#004ADE80" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="FondoContrasena" CornerRadius="14" Background="#09FFFFFF"
                                    BorderBrush="#17FFFFFF" BorderThickness="1">
                                <PasswordBox x:Name="CampoContrasena"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="White" CaretBrush="#4ADE80"
                                             FontSize="15" Margin="44,0,16,0" VerticalAlignment="Center"
                                             KeyDown="AlPresionarTeclaEnCampo"
                                             PasswordChanged="AlCambiarCampo"
                                             GotKeyboardFocus="AlEnfocarCampo"
                                             LostKeyboardFocus="AlDesenfocarCampo"
                                             ToolTip="Contraseña de Supabase Auth"/>
                            </Border>
                            <Path x:Name="IconoContrasena" Data="M5,11 H19 A2,2 0 0 1 21,13 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V13 A2,2 0 0 1 5,11 Z M8,11 V7 A5,5 0 0 1 18,7 V11"
                                  Stroke="#4DFFFFFF" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                                  Width="17" Height="17" Stretch="Uniform" IsHitTestVisible="False"/>
                            <TextBlock x:Name="EtiquetaContrasena" Text="Contraseña" FontSize="14"
                                       Foreground="#61FFFFFF" IsHitTestVisible="False"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,18,0,0"/>
                            <Border x:Name="LineaContrasena" Height="1.5" Width="0" CornerRadius="2"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0.9">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#004ADE80" Offset="0"/>
                                        <GradientStop Color="#B34ADE80" Offset="0.4"/>
                                        <GradientStop Color="#B322D3EE" Offset="0.6"/>
                                        <GradientStop Color="#004ADE80" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#4ADE80" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <Button HorizontalAlignment="Right" Margin="2,4,2,20" Cursor="Hand"
                                Click="AlRecuperarContrasena" Background="Transparent" BorderThickness="0"
                                Foreground="#A64ADE80" FontSize="12" Padding="0,4"
                                Content="¿Olvidaste tu contraseña?"/>

                        <TextBlock x:Name="Mensaje" Text="{Binding Mensaje}" FontSize="12"
                                   Foreground="#FF8A80" TextWrapping="Wrap"
                                   Margin="2,0,2,10"/>

                        <Button x:Name="BotonInicioSesion"
                                Content="ENTRAR AL PANEL"
                                Click="AlIniciarSesion"
                                IsDefault="True"
                                Height="50"
                                Style="{StaticResource BotonEntrar}"/>

                        <TextBlock Text="Sistema protegido · COGANA 2026" FontSize="11"
                                   Foreground="#38FFFFFF" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- FASE CARGA -->
        <Grid x:Name="PantallaCarga" Visibility="Collapsed" Opacity="0">
            <controles:LienzoParticulas x:Name="Lienzo"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="ContenidoCarga">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ContenidoCargaT"/>
                </StackPanel.RenderTransform>

                <Grid Width="150" Height="150" Margin="0,0,0,40">
                    <Ellipse x:Name="Anillo1" Stroke="#1F4ADE80" StrokeThickness="1" Opacity="0.6"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="Anillo1E" ScaleX="0.85" ScaleY="0.85"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Anillo2" Stroke="#144ADE80" StrokeThickness="1" Opacity="0.45"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="Anillo2E" ScaleX="0.85" ScaleY="0.85"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Anillo3" Stroke="#0A4ADE80" StrokeThickness="1" Opacity="0.3"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="Anillo3E" ScaleX="0.85" ScaleY="0.85"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse x:Name="Halo" StrokeThickness="5" Margin="-6"
                             StrokeDashArray="20.4 81.4" StrokeDashCap="Round" Opacity="0.9"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#804ADE80" Offset="0"/>
                                <GradientStop Color="#8022D3EE" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="Halor"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <BlurEffect Radius="8"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Ellipse x:Name="BrilloOrbe" Width="150" Height="150" Opacity="0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#4D4ADE80" Offset="0"/>
                                <GradientStop Color="#004ADE80" Offset="0.7"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Border Width="102" Height="102" CornerRadius="22" RenderTransformOrigin="0.5,0.5"
                            BorderBrush="#4D4ADE80" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#16211B" Offset="0"/>
                                <GradientStop Color="#202A24" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="OrbE"/>
                        </Border.RenderTransform>
                        <TextBlock Text="C" FontSize="34" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Ellipse Width="170" Height="170" StrokeThickness="1.5" Margin="-10"
                             StrokeDashArray="60 273" StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#004ADE80" Offset="0"/>
                                <GradientStop Color="#FF22D3EE" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="Arcor"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <Border x:Name="PistaProgreso" Width="290" Height="3" CornerRadius="4" Background="#12FFFFFF">
                    <Border x:Name="BarraProgresoRelleno" Height="3" CornerRadius="4"
                            HorizontalAlignment="Left" Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4ADE80" Offset="0"/>
                                <GradientStop Color="#22D3EE" Offset="0.5"/>
                                <GradientStop Color="#818CF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,8">
                    <TextBlock x:Name="TextoPorcentaje" Text="000%" FontFamily="Consolas" FontSize="11"
                               Foreground="#47FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="#BF4ADE80" Margin="2,0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="Punto1E"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="#BF4ADE80" Margin="2,0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="Punto2E"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="#BF4ADE80" Margin="2,0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="Punto3E"/></Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="TextoPaso" Text="Verificando credenciales..." FontSize="13"
                           Foreground="#80FFFFFF" HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,46,0,0" Opacity="0.16">
                    <Border Width="20" Height="20" CornerRadius="6" Background="White">
                        <TextBlock Text="C" Foreground="Black" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="COGANA" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
