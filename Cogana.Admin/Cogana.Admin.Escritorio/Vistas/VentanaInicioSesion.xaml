<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaInicioSesion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso administrativo · Cogana"
        Width="1040"
        Height="700"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0D0F0E">

    <Window.Resources>

        <!-- Fondo animado: los orbes se desplazan y respiran en bucle, cada uno a su ritmo -->
        <Storyboard x:Key="AnimacionFondo">
            <DoubleAnimation Storyboard.TargetName="Orbe1T" Storyboard.TargetProperty="X"
                             From="-70" To="90" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Orbe1T" Storyboard.TargetProperty="Y"
                             From="-40" To="55" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Orbe1E" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.18" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Orbe1E" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.18" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="Orbe2T" Storyboard.TargetProperty="X"
                             From="80" To="-90" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Orbe2T" Storyboard.TargetProperty="Y"
                             From="50" To="-60" Duration="0:0:27" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Orbe2E" Storyboard.TargetProperty="ScaleX"
                             From="1.1" To="0.92" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Orbe2E" Storyboard.TargetProperty="ScaleY"
                             From="1.1" To="0.92" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="Orbe3T" Storyboard.TargetProperty="X"
                             From="60" To="-70" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Orbe3T" Storyboard.TargetProperty="Y"
                             From="-30" To="70" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Orbe3E" Storyboard.TargetProperty="ScaleX"
                             From="0.95" To="1.15" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Orbe3E" Storyboard.TargetProperty="ScaleY"
                             From="0.95" To="1.15" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="Orbe4T" Storyboard.TargetProperty="X"
                             From="-50" To="60" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Orbe4T" Storyboard.TargetProperty="Y"
                             From="40" To="-50" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever"/>

            <!-- Partículas que flotan lentamente -->
            <DoubleAnimation Storyboard.TargetName="Particula1T" Storyboard.TargetProperty="Y"
                             From="30" To="-90" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Particula2T" Storyboard.TargetProperty="Y"
                             From="-60" To="45" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Particula2T" Storyboard.TargetProperty="X"
                             From="0" To="38" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Particula3T" Storyboard.TargetProperty="Y"
                             From="25" To="-70" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Particula3T" Storyboard.TargetProperty="X"
                             From="20" To="-30" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Particula4T" Storyboard.TargetProperty="Y"
                             From="-40" To="60" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Particula5T" Storyboard.TargetProperty="Y"
                             From="35" To="-55" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Particula5T" Storyboard.TargetProperty="X"
                             From="-25" To="35" Duration="0:0:10" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Particula6T" Storyboard.TargetProperty="Y"
                             From="-30" To="50" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource AnimacionFondo}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid>

        <!-- Capa 1: orbes de luz (gradientes radiales, sin efectos de bitmap para conservar nitidez) -->
        <Grid IsHitTestVisible="False">
            <Ellipse Width="820" Height="820" Margin="-260,-300,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.75">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#96456F62" Offset="0"/>
                        <GradientStop Color="#7A456F62" Offset="0.35"/>
                        <GradientStop Color="#3C456F62" Offset="0.68"/>
                        <GradientStop Color="#00456F62" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="Orbe1T"/>
                        <ScaleTransform x:Name="Orbe1E" CenterX="0" CenterY="0"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Width="700" Height="700" Margin="0,-240,-220,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.6">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7A5E8F7E" Offset="0"/>
                        <GradientStop Color="#625E8F7E" Offset="0.35"/>
                        <GradientStop Color="#315E8F7E" Offset="0.68"/>
                        <GradientStop Color="#005E8F7E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="Orbe2T"/>
                        <ScaleTransform x:Name="Orbe2E" CenterX="0" CenterY="0"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Width="760" Height="760" Margin="-200,0,0,-280" HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6E3D6480" Offset="0"/>
                        <GradientStop Color="#583D6480" Offset="0.35"/>
                        <GradientStop Color="#2C3D6480" Offset="0.68"/>
                        <GradientStop Color="#003D6480" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="Orbe3T"/>
                        <ScaleTransform x:Name="Orbe3E" CenterX="0" CenterY="0"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Width="560" Height="560" Margin="0,0,-160,-220" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.45">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#59C79A3F" Offset="0"/>
                        <GradientStop Color="#47C79A3F" Offset="0.35"/>
                        <GradientStop Color="#24C79A3F" Offset="0.68"/>
                        <GradientStop Color="#00C79A3F" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="Orbe4T"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Partículas flotantes -->
            <Ellipse Width="7" Height="7" Fill="#88D7E2DD" Margin="0.18,0.22,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.5">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Particula1T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="5" Height="5" Fill="#66FFFFFF" Margin="0.72,0.68,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.4">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Particula2T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="9" Height="9" Fill="#59A9C4B4" Margin="0.85,0.3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.45">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Particula3T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="4" Height="4" Fill="#77FFFFFF" Margin="0.3,0.78,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.5">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Particula4T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="6" Height="6" Fill="#66D7E2DD" Margin="0.12,0.55,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.4">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Particula5T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="5" Height="5" Fill="#59FFFFFF" Margin="0.9,0.85,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.35">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Particula6T"/></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- Capa 2: viñeta para enfocar el centro (paradas intermedias para evitar bandas) -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#000D0F0E" Offset="0.4"/>
                    <GradientStop Color="#2E0D0F0E" Offset="0.62"/>
                    <GradientStop Color="#5E0D0F0E" Offset="0.8"/>
                    <GradientStop Color="#960D0F0E" Offset="0.93"/>
                    <GradientStop Color="#B20D0F0E" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Capa 3: tarjeta de acceso flotante -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="440"
                Background="#F0FFFFFF"
                BorderBrush="#40FFFFFF"
                BorderThickness="1.5"
                CornerRadius="28"
                Padding="42,36">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource BrochaNegro}">
                        <TextBlock Text="C" Foreground="White" FontSize="22" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="COGANA" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="ADMINISTRACIÓN" FontSize="9" Foreground="{StaticResource BrochaTextoSuave}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Bienvenido" FontSize="29" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI" Margin="0,24,0,0" />

                <TextBlock Text="Correo electrónico" FontSize="12" FontWeight="SemiBold" Margin="2,24,0,8" />
                <Border Background="White" BorderBrush="{StaticResource BrochaBorde}"
                        BorderThickness="1" CornerRadius="14" Padding="14,4">
                    <TextBox x:Name="CampoCorreo"
                             Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             FontSize="14" Padding="0,8" VerticalContentAlignment="Center"
                             KeyDown="AlPresionarTeclaEnCampo"
                             ToolTip="Correo asociado a la cuenta administrativa" />
                </Border>

                <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold" Margin="2,18,0,8" />
                <Border Background="White" BorderBrush="{StaticResource BrochaBorde}"
                        BorderThickness="1" CornerRadius="14" Padding="14,4">
                    <PasswordBox x:Name="CampoContrasena"
                                 BorderThickness="0" Background="White"
                                 FontSize="14" Padding="0,8" VerticalContentAlignment="Center"
                                 KeyDown="AlPresionarTeclaEnCampo"
                                 ToolTip="Contraseña de Supabase Auth" />
                </Border>

                <TextBlock Text="{Binding Mensaje}"
                           Foreground="#9A443F" FontSize="12"
                           TextWrapping="Wrap" MinHeight="19" Margin="2,13,0,0" />

                <Button x:Name="BotonInicioSesion"
                        Content="Entrar al panel"
                        Click="AlIniciarSesion"
                        IsDefault="True"
                        Height="48" Margin="0,8,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonPrincipal}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstaProcesando}" Value="True">
                                    <Setter Property="Content" Value="Ingresando..." />
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
