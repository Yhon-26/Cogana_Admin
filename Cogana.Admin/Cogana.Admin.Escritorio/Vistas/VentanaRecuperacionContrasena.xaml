<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaRecuperacionContrasena"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar contraseña · Cogana" Width="560" Height="690" MinWidth="490" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrochaFondo}">
    <Border Margin="22" Padding="26" CornerRadius="24" Background="{StaticResource BrochaSuperficie}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="Titulo" Text="Recuperar contraseña" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="Descripcion" Margin="0,10,0,20" Foreground="{StaticResource BrochaTextoSuave}"
                           TextWrapping="Wrap" Text="Solicita el correo. En el mensaje más reciente, haz clic derecho sobre el botón y elige Copiar dirección del enlace. Pégalo aquí sin abrirlo en el navegador. Si aparece un código, también puedes usarlo."/>
                <StackPanel x:Name="PasoRecuperacion">
                    <TextBlock Text="Correo electrónico" FontWeight="SemiBold"/>
                    <TextBox x:Name="Correo" Style="{StaticResource CampoFormulario}"/>
                    <Button x:Name="Solicitar" Content="Enviar correo de recuperación" Click="AlSolicitar" Margin="0,12,0,18" Style="{StaticResource BotonSecundario}"/>
                    <TextBlock Text="Enlace original o código del correo" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="EnlaceOCodigo" Height="42" Margin="0,8,0,0" Padding="10"/>
                    <TextBlock Text="La recuperación se completa en esta ventana. Si el navegador muestra localhost o un error, solicita otro correo y copia el enlace nuevo sin abrirlo. El código solo está disponible si aparece en el correo."
                               TextWrapping="Wrap" FontSize="11" Margin="0,8,0,12" Foreground="{StaticResource BrochaTextoSuave}"/>
                    <Button x:Name="Verificar" Content="Verificar recuperación" Click="AlVerificar" Style="{StaticResource BotonPrincipal}"/>
                </StackPanel>
                <StackPanel x:Name="PasoContrasena" Visibility="Collapsed">
                    <TextBlock Text="Nueva contraseña" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="NuevaContrasena" Height="42" Padding="10" Margin="0,8,0,16"/>
                    <TextBlock Text="Confirmar nueva contraseña" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="Confirmacion" Height="42" Padding="10" Margin="0,8,0,12"/>
                    <TextBlock Text="Usa al menos 10 caracteres y una contraseña diferente a la anterior. El cambio también se aplica al acceso móvil de esta cuenta."
                               TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}"/>
                    <Button x:Name="Guardar" Content="Guardar nueva contraseña" Click="AlGuardar" Margin="0,16,0,0" Style="{StaticResource BotonPrincipal}"/>
                </StackPanel>
                <TextBlock x:Name="Mensaje" TextWrapping="Wrap" Margin="0,20,0,16" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="Volver" Content="Volver al inicio de sesión" Click="AlVolver" Style="{StaticResource BotonSecundario}"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
