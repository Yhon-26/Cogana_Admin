<Window Style="{StaticResource {x:Type Window}}" x:Class="Cogana.Admin.Escritorio.Vistas.VentanaRecuperacionContrasena"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar contraseña · Cogana" Width="600" Height="720" MinWidth="520" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="White" Foreground="#161616">
    <Window.Resources>
        <Style x:Key="Accion" TargetType="Button">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="#777777" CornerRadius="14" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Marco" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Marco" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Marco" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Enlace" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Marco" Background="Transparent" BorderBrush="#777777" Padding="2,8">
                            <TextBlock x:Name="Texto" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Texto" Property="TextDecorations" Value="Underline"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Marco" Property="BorderThickness" Value="0,0,0,1"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Marco" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CampoSecreto" TargetType="PasswordBox">
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="Foreground" Value="#161616"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="CaretBrush" Value="#161616"/>
            <Setter Property="SelectionBrush" Value="#999999"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Marco" Property="BorderBrush" Value="#777777"/><Setter TargetName="Marco" Property="Background" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Marco" Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CampoCorreo" TargetType="TextBox">
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="Foreground" Value="#161616"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="CaretBrush" Value="#161616"/>
            <Setter Property="SelectionBrush" Value="#999999"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Marco" Property="BorderBrush" Value="#777777"/><Setter TargetName="Marco" Property="Background" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RaizRecuperacion" Background="#F1F1F1">
        <Border Margin="0" Padding="32" CornerRadius="0" Background="White" BorderBrush="#E2E2E2" BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Image Source="{StaticResource LogoCogana}" Width="64" Height="64" Stretch="Uniform"
                           AutomationProperties.Name="Logo de Cogana" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="COGANA" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="SEGURIDAD DE LA CUENTA" FontSize="10" Foreground="#737373" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel x:Name="ContenidoPaso">
                        <TextBlock x:Name="Titulo" Text="Recupera tu acceso" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="Descripcion" Text="Te enviaremos un enlace para crear una nueva contraseña." Foreground="#666666" FontSize="13" Margin="0,8,0,24" TextWrapping="Wrap"/>
                        <Grid x:Name="IndicadorPasos" Margin="0,0,0,26">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0"><Border x:Name="BarraPaso1" Height="3" CornerRadius="2" Background="#161616"/><TextBlock x:Name="EtiquetaPaso1" Text="1  CORREO" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0"><Border x:Name="BarraPaso2" Height="3" CornerRadius="2" Background="#E7E7E7"/><TextBlock x:Name="EtiquetaPaso2" Text="2  VERIFICACIÓN" Foreground="#888888" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><Border x:Name="BarraPaso3" Height="3" CornerRadius="2" Background="#E7E7E7"/><TextBlock x:Name="EtiquetaPaso3" Text="3  CONTRASEÑA" Foreground="#888888" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                        </Grid>
                        <StackPanel x:Name="PasoCorreo">
                            <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="Correo" Style="{StaticResource CampoCorreo}" KeyDown="AlPresionarEnter" AutomationProperties.Name="Correo electrónico de la cuenta"/>
                            <TextBlock Text="Usa el correo de tu cuenta administrativa." FontSize="12" Foreground="#737373" TextWrapping="Wrap" Margin="0,10,0,24"/>
                            <Button x:Name="TengoEnlace" Content="Ya tengo un enlace o código" Click="AlTengoEnlace" Style="{StaticResource Enlace}" Margin="0,12,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="PasoRecuperacion" Visibility="Collapsed">
                            <Border Background="#F7F7F7" CornerRadius="14" Padding="16" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Copia el enlace del correo más reciente" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="1. Haz clic derecho en el botón del correo.&#10;2. Elige Copiar dirección del enlace.&#10;3. Pégalo aquí, sin abrirlo en el navegador." Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="Si el correo contiene un código, también puedes usarlo." Foreground="#737373" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="ENLACE ORIGINAL O CÓDIGO" Style="{StaticResource Etiqueta}"/>
                            <PasswordBox x:Name="EnlaceOCodigo" Style="{StaticResource CampoSecreto}" KeyDown="AlPresionarEnter" AutomationProperties.Name="Enlace original o código de recuperación"/>
                            <TextBlock Text="Si abriste el enlace y apareció localhost o un error, solicita otro correo y copia el enlace nuevo sin abrirlo." Foreground="#737373" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,20"/>
                            <Grid Margin="0,10,0,0">
                                <Button x:Name="Reenviar" Content="Enviar otro correo" Click="AlSolicitar" Style="{StaticResource Enlace}" HorizontalAlignment="Left"/>
                                <Button x:Name="CambiarCorreo" Content="Cambiar correo" Click="AlCambiarCorreo" Style="{StaticResource Enlace}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="PasoContrasena" Visibility="Collapsed">
                            <TextBlock Text="NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                            <PasswordBox x:Name="NuevaContrasena" Style="{StaticResource CampoSecreto}" PasswordChanged="AlCambiarContrasena" KeyDown="AlPresionarEnter" AutomationProperties.Name="Nueva contraseña"/>
                            <TextBlock x:Name="ReglaLongitud" Text="Usa al menos 10 caracteres." FontSize="12" Foreground="#737373" Margin="0,10,0,20"/>
                            <TextBlock Text="CONFIRMA TU CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                            <PasswordBox x:Name="Confirmacion" Style="{StaticResource CampoSecreto}" PasswordChanged="AlCambiarContrasena" KeyDown="AlPresionarEnter" AutomationProperties.Name="Confirmar nueva contraseña"/>
                            <TextBlock x:Name="ReglaConfirmacion" Text="Repite la nueva contraseña." FontSize="12" Foreground="#737373" Margin="0,10,0,20"/>
                            <Border Background="#F7F7F7" CornerRadius="14" Padding="14" Margin="0,0,0,20">
                                <TextBlock Text="Elige una contraseña diferente a la anterior. El cambio también se aplicará al acceso móvil de esta cuenta." FontSize="12" Foreground="#666666" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="PasoCompletado" Visibility="Collapsed" Margin="0,4,0,20">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#161616" HorizontalAlignment="Left" Margin="0,0,0,20">
                                <Path Data="M18,32 L28,42 L46,22" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <TextBlock Text="Tu nueva contraseña está lista." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Vuelve al inicio de sesión e ingresa con tu nueva contraseña. Si usas Recordar cuenta, márcalo antes de entrar." FontSize="13" Foreground="#666666" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                        <Border x:Name="PanelMensaje" Visibility="Collapsed" Background="#F7F7F7" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                            <TextBlock x:Name="Mensaje" TextWrapping="Wrap" FontSize="12" Foreground="#444444" AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                        <ProgressBar x:Name="Progreso" Visibility="Collapsed" Height="3" Margin="0,14,0,8" IsIndeterminate="True" Foreground="#161616" Background="#E7E7E7" BorderThickness="0" AutomationProperties.Name="Procesando recuperación"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,22,0,0">
                    <Border Height="1" Background="#EEEEEE" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10">
                        <Button x:Name="Solicitar" Content="Enviar enlace de recuperación" Click="AlSolicitar" Style="{StaticResource Accion}"/>
                        <Button x:Name="Verificar" Content="Verificar enlace" Click="AlVerificar" Style="{StaticResource Accion}" Visibility="Collapsed"/>
                        <Button x:Name="Guardar" Content="Guardar nueva contraseña" Click="AlGuardar" Style="{StaticResource Accion}" Visibility="Collapsed"/>
                    </Grid>
                    <Button x:Name="Volver" Content="Volver al inicio de sesión" Click="AlVolver" Style="{StaticResource Enlace}"/>
                    <TextBlock Text="Sistema protegido · COGANA 2026" FontSize="11" Foreground="#737373" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
