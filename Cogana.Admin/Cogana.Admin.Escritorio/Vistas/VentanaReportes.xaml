<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaReportes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reportes de Cogana"
        Width="1160" Height="820" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BrochaFondo}">
    <Window.Resources>
        <Style x:Key="PestanaReporte" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource BrochaTextoSuave}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="FondoPestana" Background="Transparent" CornerRadius="13"
                                Padding="14,8" Margin="0,0,6,0">
                            <ContentPresenter x:Name="TextoPestana" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoPestana" Property="Background" Value="#ECEEEC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FondoPestana" Property="Background" Value="{StaticResource BrochaNegro}" />
                                <Setter TargetName="TextoPestana" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EncabezadoTablaReporte" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F3F1" />
            <Setter Property="Foreground" Value="{StaticResource BrochaTextoSuave}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrochaBorde}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CeldaTablaReporte" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FilaTablaReporte" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#ECEDEA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{StaticResource BrochaTexto}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F7F5" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrochaAcentoSuave}" />
                    <Setter Property="Foreground" Value="{StaticResource BrochaTexto}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TablaReporte" TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrochaBorde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource EncabezadoTablaReporte}" />
            <Setter Property="CellStyle" Value="{StaticResource CeldaTablaReporte}" />
            <Setter Property="RowStyle" Value="{StaticResource FilaTablaReporte}" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Border Background="{StaticResource BrochaSuperficie}" BorderBrush="#12000000"
                BorderThickness="1" CornerRadius="28" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource BrochaNegro}">
                        <TextBlock Text="R" Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Reportes de la tienda" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Ventas, pedidos, productos, pagos e inventario desde Supabase"
                                   Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="Periodo" Width="145" Height="40" SelectionChanged="AlCambiarPeriodo"
                                  SelectedValuePath="Tag" Margin="0,0,8,0">
                            <ComboBoxItem Content="Últimos 7 días" Tag="7" />
                            <ComboBoxItem Content="Últimos 30 días" Tag="30" IsSelected="True" />
                            <ComboBoxItem Content="Este mes" Tag="month" />
                            <ComboBoxItem Content="Personalizado" Tag="custom" />
                        </ComboBox>
                        <DatePicker x:Name="FechaInicio" Width="130" Height="40" Margin="0,0,8,0" />
                        <DatePicker x:Name="FechaFin" Width="130" Height="40" Margin="0,0,8,0" />
                        <Button x:Name="BotonConsultar" Content="Consultar" Click="AlConsultar"
                                Style="{StaticResource BotonPrincipal}" />
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="5" Margin="0,20,0,16">
                    <Border Background="#F2F3F1" CornerRadius="16" Padding="15" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="VENTAS" FontSize="9" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock x:Name="TotalVentas" Text="S/ 0.00" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                    </Border>
                    <Border Background="#F2F3F1" CornerRadius="16" Padding="15" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="PEDIDOS" FontSize="9" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock x:Name="TotalPedidos" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                    </Border>
                    <Border Background="#F2F3F1" CornerRadius="16" Padding="15" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="TICKET PROMEDIO" FontSize="9" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock x:Name="TicketPromedio" Text="S/ 0.00" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                    </Border>
                    <Border Background="#F7EFE4" CornerRadius="16" Padding="15" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="STOCK BAJO" FontSize="9" Foreground="#80623E" />
                            <TextBlock x:Name="TotalStockBajo" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                    </Border>
                    <Border Background="#F4E8E6" CornerRadius="16" Padding="15">
                        <StackPanel><TextBlock Text="LOTES POR VENCER" FontSize="9" Foreground="#8C514B" />
                            <TextBlock x:Name="TotalVencimientos" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Background="#EEF4F1" CornerRadius="13" Padding="12" Margin="0,0,0,14">
                    <TextBlock x:Name="ResumenPeriodo" Text="Selecciona un periodo para consultar."
                               FontSize="10" Foreground="#34473F" />
                </Border>

                <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0"
                            ItemContainerStyle="{StaticResource PestanaReporte}">
                    <TabItem Header="Ventas y pedidos">
                        <Grid Margin="8,15,12,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <DataGrid x:Name="TablaVentasDiarias" AutoGenerateColumns="False"
                                      Style="{StaticResource TablaReporte}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="*" />
                                    <DataGridTextColumn Header="Pedidos completados" Binding="{Binding Pedidos}" Width="150" />
                                    <DataGridTextColumn Header="Ventas" Binding="{Binding Ventas}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid Grid.Column="2" x:Name="TablaEstados" AutoGenerateColumns="False"
                                      Style="{StaticResource TablaReporte}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                                    <DataGridTextColumn Header="Pedidos" Binding="{Binding Pedidos}" Width="90" />
                                    <DataGridTextColumn Header="Importe" Binding="{Binding Total}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Productos vendidos">
                        <DataGrid x:Name="TablaProductos" Margin="8,15,12,8" AutoGenerateColumns="False"
                                  Style="{StaticResource TablaReporte}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*" />
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="130" />
                                <DataGridTextColumn Header="Pedidos" Binding="{Binding Pedidos}" Width="110" />
                                <DataGridTextColumn Header="Ventas" Binding="{Binding Ventas}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Métodos de pago">
                        <DataGrid x:Name="TablaPagos" Margin="8,15,12,8" AutoGenerateColumns="False"
                                  Style="{StaticResource TablaReporte}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Método" Binding="{Binding Metodo}" Width="*" />
                                <DataGridTextColumn Header="Pedidos completados" Binding="{Binding Pedidos}" Width="180" />
                                <DataGridTextColumn Header="Importe" Binding="{Binding Total}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Inventario">
                        <Grid Margin="8,15,12,8">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <GroupBox Header="Productos con stock bajo" Padding="8">
                                <DataGrid x:Name="TablaStockBajo" AutoGenerateColumns="False"
                                          Style="{StaticResource TablaReporte}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*" />
                                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="110" />
                                        <DataGridTextColumn Header="Stock actual" Binding="{Binding Actual}" Width="130" />
                                        <DataGridTextColumn Header="Stock mínimo" Binding="{Binding Minimo}" Width="130" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GroupBox Grid.Row="2" Header="Lotes vencidos o próximos a vencer" Padding="8">
                                <DataGrid x:Name="TablaVencimientos" AutoGenerateColumns="False"
                                          Style="{StaticResource TablaReporte}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Lote" Binding="{Binding Lote}" Width="130" />
                                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*" />
                                        <DataGridTextColumn Header="Vencimiento" Binding="{Binding Fecha}" Width="130" />
                                        <DataGridTextColumn Header="Cantidad suelta" Binding="{Binding Cantidad}" Width="130" />
                                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Grid Grid.Row="4" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MensajeFormulario" Foreground="#9A443F" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BotonExportar" Content="Exportar reporte CSV" Click="AlExportar"
                                Style="{StaticResource BotonSecundario}" IsEnabled="False" Margin="0,0,9,0" />
                        <Button Content="Cerrar" Click="AlCerrar" Style="{StaticResource BotonPrincipal}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
