<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaImagenProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imagen del producto · Cogana" Width="820" Height="650" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F1F1F1">
    <Border Margin="24" Padding="24" Background="White" CornerRadius="24">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Imagen del producto" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="NombreProducto" FontSize="14" Foreground="#666666" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#F7F7F7" CornerRadius="16" Padding="16">
                <Grid>
                    <Image x:Name="FotoProducto" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" AutomationProperties.Name="Imagen del producto"/>
                    <TextBlock x:Name="EstadoImagen" Text="Cargando imagen…" FontSize="14" Foreground="#666666" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="BotonRecargar" Content="Volver a cargar" Click="AlRecargar" Style="{StaticResource BotonSecundario}" HorizontalAlignment="Left"/>
                <Button Grid.Column="1" Content="Cerrar" Click="AlCerrar" Style="{StaticResource BotonPrincipal}" IsCancel="True" Padding="24,10"/>
            </Grid>
        </Grid>
    </Border>
</Window>
