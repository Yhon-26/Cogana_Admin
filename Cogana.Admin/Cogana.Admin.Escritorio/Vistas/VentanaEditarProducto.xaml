<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaEditarProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle del producto"
        Width="820"
        Height="760"
        MinWidth="760"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BrochaFondo}">
    <Grid Margin="22">
        <Border Background="{StaticResource BrochaSuperficie}"
                BorderBrush="#12000000"
                BorderThickness="1"
                CornerRadius="28"
                Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="16"
                            Background="{StaticResource BrochaNegro}">
                        <TextBlock Text="P" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TituloProducto" Text="Cargando producto..."
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Detalle y edición del catálogo de Cogana"
                                   Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="EtiquetaEstado"
                            Background="{StaticResource BrochaAcentoSuave}"
                            CornerRadius="13" Padding="13,7" VerticalAlignment="Center">
                        <TextBlock x:Name="TextoEstado" Text="Consultando"
                                   Foreground="{StaticResource BrochaAcento}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="3" Margin="0,22,0,18">
                    <Border Style="{StaticResource Tarjeta}" Padding="18" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Presentaciones activas" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock x:Name="TotalPresentaciones" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" Padding="18" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Lotes disponibles" FontSize="11" Foreground="{StaticResource BrochaTextoSuave}" />
                            <TextBlock x:Name="TotalLotes" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BrochaNegro}" CornerRadius="22" Padding="18" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Stock total" FontSize="11" Foreground="#BFC4C0" />
                            <TextBlock x:Name="TotalStock" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="White" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,0,8,5">
                        <StackPanel x:Name="SeccionImagen" Margin="0,0,0,18">
                            <Border Height="150" CornerRadius="14" Background="#F0F1EF"
                                    BorderBrush="{StaticResource BrochaBorde}" BorderThickness="1">
                                <Grid>
                                    <TextBlock x:Name="TextoImagenProducto"
                                               Text="Sin imagen. La app móvil mostrará una foto referencial."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource BrochaTextoSuave}"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="26,0"/>
                                    <Image x:Name="VistaPreviaImagen" Stretch="Uniform" Margin="6" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Content="Elegir imagen…" Click="AlElegirImagen" Style="{StaticResource BotonSecundario}"/>
                                <Button x:Name="BotonQuitarImagen" Content="Quitar" Click="AlQuitarImagen"
                                        Style="{StaticResource BotonSecundario}" Margin="8,0,0,0" Visibility="Collapsed"/>
                                <TextBlock Text="JPG o PNG (máx. 5 MB). Se muestra en la app móvil."
                                           FontSize="10" Foreground="{StaticResource BrochaTextoSuave}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,0">
                                <TextBlock Text="Nombre del producto *" FontSize="11" FontWeight="SemiBold" />
                                <TextBox x:Name="ProductoNombre" Style="{StaticResource CampoFormulario}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="SKU" FontSize="11" FontWeight="SemiBold" />
                                <TextBox x:Name="ProductoSku" Style="{StaticResource CampoFormulario}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,0">
                                <TextBlock Text="Marca" FontSize="11" FontWeight="SemiBold" />
                                <TextBox x:Name="ProductoMarca" Style="{StaticResource CampoFormulario}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="Categoría" FontSize="11" FontWeight="SemiBold" />
                                <ComboBox x:Name="ProductoCategoria" Style="{StaticResource SelectorFormulario}"
                                          DisplayMemberPath="Nombre" SelectedValuePath="Id" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,0">
                                <TextBlock Text="Unidad base *" FontSize="11" FontWeight="SemiBold" />
                                <ComboBox x:Name="ProductoUnidad" Style="{StaticResource SelectorFormulario}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Gramos" Tag="gram" />
                                    <ComboBoxItem Content="Unidades" Tag="unit" />
                                    <ComboBoxItem Content="Mililitros" Tag="milliliter" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="Stock mínimo" FontSize="11" FontWeight="SemiBold" />
                                <TextBox x:Name="ProductoStockMinimo" Style="{StaticResource CampoFormulario}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Descripción" FontSize="11" FontWeight="SemiBold" Margin="0,15,0,0" />
                        <TextBox x:Name="ProductoDescripcion" Style="{StaticResource CampoFormulario}"
                                 Height="78" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />

                        <CheckBox x:Name="ProductoVencimiento"
                                  Content="Controlar fecha de vencimiento en sus lotes"
                                  Margin="2,17,0,0" FontSize="12" />

                        <Border Background="{StaticResource BrochaAcentoSuave}" CornerRadius="15"
                                Padding="14" Margin="0,17,0,0">
                            <TextBlock Text="Los cambios se comparten con la aplicación móvil mediante la misma base de datos de Cogana."
                                       Foreground="{StaticResource BrochaAcento}" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MensajeFormulario" Foreground="#9A443F" FontSize="11"
                               TextWrapping="Wrap" MinHeight="18" Margin="1,0,0,10" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cerrar" Click="AlCancelar" Style="{StaticResource BotonSecundario}" Margin="0,0,9,0" />
                        <Button x:Name="BotonGuardar" Content="Guardar cambios" Click="AlGuardar"
                                Style="{StaticResource BotonPrincipal}" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
