<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaEditarPromocion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar promoción"
        Width="980"
        Height="810"
        MinWidth="900"
        MinHeight="730"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BrochaFondo}">
    <Grid Margin="22">
        <Border Background="{StaticResource BrochaSuperficie}" BorderBrush="#12000000"
                BorderThickness="1" CornerRadius="28" Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource BrochaNegro}">
                        <TextBlock Text="%" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TituloPromocion" Text="Cargando promoción..."
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Reglas, vigencia y productos participantes"
                                   Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="EtiquetaEstado" Background="{StaticResource BrochaAcentoSuave}"
                            CornerRadius="13" Padding="13,7" VerticalAlignment="Center">
                        <TextBlock x:Name="TextoEstado" Text="Consultando" Foreground="{StaticResource BrochaAcento}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" BorderBrush="{StaticResource BrochaBorde}" BorderThickness="1"
                            CornerRadius="21" Padding="20" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,2">
                                <TextBlock Text="Información y beneficio" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Nombre *" FontSize="10" FontWeight="SemiBold" Margin="0,14,0,0" />
                                <TextBox x:Name="PromocionNombre" Style="{StaticResource CampoFormulario}" />
                                <TextBlock Text="Descripción" FontSize="10" FontWeight="SemiBold" Margin="0,13,0,0" />
                                <TextBox x:Name="PromocionDescripcion" Style="{StaticResource CampoFormulario}"
                                         Height="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />

                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,7,0">
                                        <TextBlock Text="Tipo *" FontSize="10" FontWeight="SemiBold" />
                                        <ComboBox x:Name="PromocionTipo" Style="{StaticResource SelectorFormulario}"
                                                  SelectedValuePath="Tag" SelectionChanged="AlCambiarTipo">
                                            <ComboBoxItem Content="Porcentaje" Tag="percentage" />
                                            <ComboBoxItem Content="Descuento fijo" Tag="fixed_amount" />
                                            <ComboBoxItem Content="Precio fijo" Tag="fixed_price" />
                                            <ComboBoxItem Content="Precio por cantidad" Tag="quantity_price" />
                                            <ComboBoxItem Content="Delivery gratis" Tag="free_delivery" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock x:Name="EtiquetaValor" Text="Valor *" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox x:Name="PromocionValor" Style="{StaticResource CampoFormulario}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,7,0">
                                        <TextBlock Text="Inicio *" FontSize="10" FontWeight="SemiBold" />
                                        <DatePicker x:Name="PromocionInicio" Background="White" BorderBrush="{StaticResource BrochaBorde}" Padding="8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="Fin *" FontSize="10" FontWeight="SemiBold" />
                                        <DatePicker x:Name="PromocionFin" Background="White" BorderBrush="{StaticResource BrochaBorde}" Padding="8" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Condiciones" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,0" />
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,7,0">
                                        <TextBlock Text="Pedido mínimo (S/)" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox x:Name="PromocionPedidoMinimo" Style="{StaticResource CampoFormulario}" />
                                    </StackPanel>
                                    <StackPanel x:Name="ContenedorCantidadMinima" Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="Cantidad mínima" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox x:Name="PromocionCantidadMinima" Style="{StaticResource CampoFormulario}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,7,0">
                                        <TextBlock Text="Código de cupón" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox x:Name="PromocionCupon" Style="{StaticResource CampoFormulario}" CharacterCasing="Upper" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="Prioridad" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox x:Name="PromocionPrioridad" Style="{StaticResource CampoFormulario}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,7,0">
                                        <TextBlock Text="Límite total de usos" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox x:Name="PromocionLimiteUsos" Style="{StaticResource CampoFormulario}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="Límite por cliente" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox x:Name="PromocionLimiteCliente" Style="{StaticResource CampoFormulario}" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="PromocionAcumulable" Content="Se puede acumular con otras promociones"
                                          Margin="2,16,0,2" FontSize="11" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BrochaBorde}" BorderThickness="1"
                            CornerRadius="21" Padding="20" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Productos participantes" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="ResumenProductos" Text="Cargando productos..."
                                           FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,13,0,10">
                                <Button Content="Seleccionar todos" Click="AlSeleccionarTodos" Style="{StaticResource BotonSecundario}" Margin="0,0,8,0" />
                                <Button Content="Aplicar a todos" Click="AlQuitarSeleccion" Style="{StaticResource BotonSecundario}" />
                            </StackPanel>
                            <ListBox Grid.Row="2" x:Name="ListaProductos" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrochaBorde}" BorderThickness="0,0,0,1" Padding="8,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="{Binding Nombre}" IsChecked="{Binding EstaSeleccionado, Mode=TwoWay}"
                                                          Click="AlCambiarProducto" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Estado}" FontSize="9"
                                                           Foreground="{StaticResource BrochaTextoSuave}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="3" Background="{StaticResource BrochaAcentoSuave}" CornerRadius="15" Padding="14" Margin="0,12,0,0">
                                <TextBlock Text="Si no seleccionas productos, la promoción se considera general para todo el catálogo."
                                           Foreground="{StaticResource BrochaAcento}" FontSize="10" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MensajeFormulario" Foreground="#9A443F" FontSize="11"
                               TextWrapping="Wrap" MinHeight="18" Margin="1,0,0,10" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cerrar" Click="AlCerrar" Style="{StaticResource BotonSecundario}" Margin="0,0,9,0" />
                        <Button x:Name="BotonGuardar" Content="Guardar promoción" Click="AlGuardar"
                                Style="{StaticResource BotonPrincipal}" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
