<Window Style="{StaticResource {x:Type Window}}" x:Class="Cogana.Admin.Escritorio.Vistas.VentanaOnboarding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:Cogana.Admin.Escritorio.Controles"
        Title="Bienvenido · Cogana Admin"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F1F1F1"
        Foreground="#161616">

    <Window.Resources>

        <!-- Estilo del enlace discreto (hermana del enlace de recuperación del login) -->
        <Style x:Key="EnlaceSaltar" TargetType="Button">
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocoEnlace" Background="Transparent" Padding="0,6" BorderBrush="#161616">
                            <TextBlock x:Name="TextoEnlace" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextoEnlace" Property="TextDecorations" Value="Underline"/>
                                <Setter Property="Foreground" Value="#161616"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocoEnlace" Property="BorderThickness" Value="0,0,0,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones de navegación del pie -->
        <Style x:Key="BotonContinuar" TargetType="Button">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoBoton" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FondoBoton" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FondoBoton" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="FondoBoton" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonAnterior" TargetType="Button" BasedOn="{StaticResource BotonContinuar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoBoton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#26161616" BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoBoton" Property="Background" Value="#0D161616"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FondoBoton" Property="BorderBrush" Value="#161616"/>
                                <Setter TargetName="FondoBoton" Property="BorderThickness" Value="1.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta de módulo de la página 2 -->
        <Style x:Key="TarjetaModulo" TargetType="Border">
            <Setter Property="Background" Value="#0A161616"/>
            <Setter Property="BorderBrush" Value="#14161616"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14161616"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconoModulo" TargetType="Path">
            <Setter Property="Stroke" Value="#161616"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="ChipPalabra" TargetType="Border">
            <Setter Property="Background" Value="#0A161616"/>
            <Setter Property="BorderBrush" Value="#14161616"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- Deriva lenta de las capas de aurora (misma coreografía del login) -->
        <Storyboard x:Key="AnimacionAurora">
            <DoubleAnimation Storyboard.TargetName="LavadoVerdeT" Storyboard.TargetProperty="X"
                             From="-20" To="24" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LavadoVerdeT" Storyboard.TargetProperty="Y"
                             From="0" To="-18" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LavadoAzulT" Storyboard.TargetProperty="X"
                             From="18" To="-22" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LavadoAzulT" Storyboard.TargetProperty="Y"
                             From="14" To="-12" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LavadoVioletaT" Storyboard.TargetProperty="X"
                             From="-14" To="16" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LavadoVioletaT" Storyboard.TargetProperty="Y"
                             From="10" To="-14" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- Brillo giratorio sobre el borde de la tarjeta -->
        <Storyboard x:Key="AnimacionBrilloTarjeta">
            <DoubleAnimation Storyboard.TargetName="BrilloRotador" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:9" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- Entrada de la tarjeta al abrir la ventana -->
        <Storyboard x:Key="AnimacionEntrada">
            <DoubleAnimation Storyboard.TargetName="TarjetaT" Storyboard.TargetProperty="Y"
                             From="40" To="0" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TarjetaEscala" Storyboard.TargetProperty="ScaleX"
                             From="0.94" To="1" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TarjetaEscala" Storyboard.TargetProperty="ScaleY"
                             From="0.94" To="1" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TarjetaOnboarding" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.7"/>
        </Storyboard>

        <!-- Detalles vivos: blob flotante, punto EN LÍNEA y anillos del emblema -->
        <Storyboard x:Key="AnimacionVida">
            <DoubleAnimation Storyboard.TargetName="BlobFlotanteT" Storyboard.TargetProperty="X"
                             From="0" To="-12" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="BlobFlotanteT" Storyboard.TargetProperty="Y"
                             From="0" To="16" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PuntoLinea" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.3" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AnilloB1E" Storyboard.TargetProperty="ScaleX"
                             From="0.9" To="1.25" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AnilloB1E" Storyboard.TargetProperty="ScaleY"
                             From="0.9" To="1.25" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AnilloB1" Storyboard.TargetProperty="Opacity"
                             From="0.5" To="0.12" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AnilloB2E" Storyboard.TargetProperty="ScaleX"
                             From="1.1" To="1.45" Duration="0:0:3.1" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AnilloB2E" Storyboard.TargetProperty="ScaleY"
                             From="1.1" To="1.45" Duration="0:0:3.1" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AnilloB2" Storyboard.TargetProperty="Opacity"
                             From="0.32" To="0.05" Duration="0:0:3.1" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="ArcoBienvenida" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:7" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- Flujo de la página 3: paquetes que viajan del móvil al panel (ciclo de 2.6 s) -->
        <Storyboard x:Key="FlujoSincronia">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1T" Storyboard.TargetProperty="X"
                                           Duration="0:0:2.6" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.25" Value="176"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:2.6" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.05" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.25" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2T" Storyboard.TargetProperty="X"
                                           Duration="0:0:2.6" RepeatBehavior="Forever" BeginTime="0:0:0.55">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.25" Value="176"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:2.6" RepeatBehavior="Forever" BeginTime="0:0:0.55">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.05" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.25" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3T" Storyboard.TargetProperty="X"
                                           Duration="0:0:2.6" RepeatBehavior="Forever" BeginTime="0:0:1.1">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.25" Value="176"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:2.6" RepeatBehavior="Forever" BeginTime="0:0:1.1">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.05" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.25" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TelefonoE" Storyboard.TargetProperty="ScaleX"
                                           Duration="0:0:2.6" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.18" Value="1.035"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TelefonoE" Storyboard.TargetProperty="ScaleY"
                                           Duration="0:0:2.6" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.18" Value="1.035"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PanelE" Storyboard.TargetProperty="ScaleX"
                                           Duration="0:0:2.6" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="1.025"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.45" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PanelE" Storyboard.TargetProperty="ScaleY"
                                           Duration="0:0:2.6" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="1.025"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.45" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChipMas1" Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:2.6" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:1.95" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.15" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.45" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HaloContador" Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:2.6" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:1.95" Value="0.25"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0.85"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.45" Value="0.85"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="0.25"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Entradas escalonadas de cada acto -->
        <Storyboard x:Key="EntradaPagina1">
            <DoubleAnimation Storyboard.TargetName="HeroBienvenidaE" Storyboard.TargetProperty="ScaleX"
                             From="0.72" To="1" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeroBienvenidaE" Storyboard.TargetProperty="ScaleY"
                             From="0.72" To="1" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeroBienvenida" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45"/>
            <DoubleAnimation Storyboard.TargetName="TituloBienvenidaT" Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.5" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TituloBienvenida" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="SubtituloBienvenidaT" Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.5" BeginTime="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SubtituloBienvenida" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="ChipLineaT" Storyboard.TargetProperty="Y"
                             From="14" To="0" Duration="0:0:0.45" BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ChipLinea" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="EntradaPagina2">
            <DoubleAnimation Storyboard.TargetName="Titulo2T" Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Titulo2" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="Sub2T" Storyboard.TargetProperty="Y"
                             From="16" To="0" Duration="0:0:0.5" BeginTime="0:0:0.08">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Sub2" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="Modulo1T" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.5" BeginTime="0:0:0.16">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Modulo1" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetName="Modulo2T" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.5" BeginTime="0:0:0.22">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Modulo2" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="Modulo3T" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.5" BeginTime="0:0:0.28">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Modulo3" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.28"/>
            <DoubleAnimation Storyboard.TargetName="Modulo4T" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.5" BeginTime="0:0:0.34">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Modulo4" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.34"/>
            <DoubleAnimation Storyboard.TargetName="Modulo5T" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.5" BeginTime="0:0:0.4">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Modulo5" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="Modulo6T" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.5" BeginTime="0:0:0.46">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Modulo6" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.46"/>
        </Storyboard>

        <Storyboard x:Key="EntradaPagina3">
            <DoubleAnimation Storyboard.TargetName="Titulo3T" Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Titulo3" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="Sub3T" Storyboard.TargetProperty="Y"
                             From="16" To="0" Duration="0:0:0.5" BeginTime="0:0:0.08">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Sub3" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="TelefonoT" Storyboard.TargetProperty="X"
                             From="-34" To="0" Duration="0:0:0.55" BeginTime="0:0:0.18">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Telefono" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="PanelT" Storyboard.TargetProperty="X"
                             From="34" To="0" Duration="0:0:0.55" BeginTime="0:0:0.26">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.26"/>
            <DoubleAnimation Storyboard.TargetName="Chips3T" Storyboard.TargetProperty="Y"
                             From="16" To="0" Duration="0:0:0.5" BeginTime="0:0:0.36">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Chips3" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.36"/>
        </Storyboard>

        <Storyboard x:Key="EntradaPagina4">
            <DoubleAnimation Storyboard.TargetName="Titulo4T" Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Titulo4" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="Paso1E" Storyboard.TargetProperty="ScaleX"
