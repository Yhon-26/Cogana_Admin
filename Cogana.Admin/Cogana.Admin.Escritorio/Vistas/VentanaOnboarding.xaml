                                                    </StackPanel>
                                                    <Border Grid.Row="1" CornerRadius="14" Background="#0A161616" Padding="12" Margin="0,12,0,0">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Border Width="34" Height="34" CornerRadius="10" Background="#14161616" HorizontalAlignment="Left">
                                                                    <Path Style="{StaticResource IconoModulo}" Width="17" Height="17"
                                                                          Data="M6.5,2.5 H17.5 A1.5,1.5 0 0 1 19,4 V21.5 L15.8,19.7 L12.9,21.5 L10,19.7 L7.1,21.5 L5,20 V4 A1.5,1.5 0 0 1 6.5,2.5 Z M8.5,7.5 H15.5 M8.5,11 H15.5 M8.5,14.5 H13"/>
                                                                </Border>
                                                                <TextBlock Text="Nuevo" FontSize="9" FontWeight="Bold" Foreground="#238B45"
                                                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                                                            </Grid>
                                                            <TextBlock Text="Pedido del cliente" FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                                            <TextBlock Text="Recojo en tienda · hace un momento" FontSize="9.5" Foreground="#8C8C8C" Margin="0,2,0,0"/>
                                                            <Border Height="6" CornerRadius="3" Background="#14161616" Margin="0,10,40,0"/>
                                                            <Border Height="6" CornerRadius="3" Background="#0F161616" Margin="0,4,80,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Row="2" Text="Aplicación móvil" FontSize="9.5" Foreground="#8C8C8C"
                                                               HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Conector: paquetes que viajan -->
                                            <Grid Grid.Column="1" Margin="14,0">
                                                <Border Height="2" VerticalAlignment="Center" CornerRadius="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#00161616" Offset="0"/>
                                                            <GradientStop Color="#33161616" Offset="0.5"/>
                                                            <GradientStop Color="#00161616" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="#161616" VerticalAlignment="Center"
                                                         HorizontalAlignment="Left" Opacity="0" Margin="0,0,0,0">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform x:Name="Dot1T"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="Dot2" Width="5" Height="5" Fill="#40161616" VerticalAlignment="Center"
                                                         HorizontalAlignment="Left" Opacity="0" Margin="0,14,0,0">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform x:Name="Dot2T"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="#40161616" VerticalAlignment="Center"
                                                         HorizontalAlignment="Left" Opacity="0" Margin="0,-14,0,0">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform x:Name="Dot3T"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Grid>

                                            <!-- Panel: donde el pedido se atiende -->
                                            <Border x:Name="Panel" Grid.Column="2" Width="238" Height="188" CornerRadius="24"
                                                    Background="#FCFFFFFF" BorderBrush="#17161616" BorderThickness="1"
                                                    RenderTransformOrigin="0.5,0.5" Opacity="0">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="PanelE"/>
                                                        <TranslateTransform x:Name="PanelT"/>
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <Grid Margin="16">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Pedidos" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <Border Background="#14161616" CornerRadius="9" Padding="7,2" Margin="8,0,0,0">
                                                            <Grid>
                                                                <Ellipse x:Name="HaloContador" Width="26" Height="18" Opacity="0.25"
                                                                         IsHitTestVisible="False">
                                                                    <Ellipse.Fill>
                                                                        <RadialGradientBrush>
                                                                            <GradientStop Color="#80238B45" Offset="0"/>
                                                                            <GradientStop Color="#00238B45" Offset="1"/>
                                                                        </RadialGradientBrush>
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                                <TextBlock Text="4" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="ChipMas1" Background="#238B45" CornerRadius="8" Padding="6,1"
                                                                Margin="6,0,0,0" Opacity="0" VerticalAlignment="Center">
                                                            <TextBlock Text="+1" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                        <Border Height="9" CornerRadius="4" Background="#0F161616" Margin="0,5,50,0"/>
                                                        <Border Height="9" CornerRadius="4" Background="#0F161616" Margin="0,7,90,0"/>
                                                        <Border Height="9" CornerRadius="4" Background="#0A161616" Margin="0,7,30,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="2" Text="Cogana Admin · tu panel" FontSize="9.5" Foreground="#8C8C8C"
                                                               HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <StackPanel x:Name="Chips3" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5" Opacity="0">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform x:Name="Chips3T"/>
                                            </StackPanel.RenderTransform>
                                            <Border Style="{StaticResource ChipPalabra}"><TextBlock Text="Pedidos" FontSize="11"/></Border>
                                            <Border Style="{StaticResource ChipPalabra}"><TextBlock Text="Stock" FontSize="11"/></Border>
                                            <Border Style="{StaticResource ChipPalabra}"><TextBlock Text="Clientes" FontSize="11"/></Border>
                                            <Border Style="{StaticResource ChipPalabra}"><TextBlock Text="Reportes" FontSize="11"/></Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- ACTO 4 · Empezar -->
                                <Grid x:Name="Pagina4" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="Pagina4T"/>
                                    </Grid.RenderTransform>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                                        <TextBlock x:Name="Titulo4" Text="Todo listo para empezar"
                                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5" Opacity="0">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="Titulo4T"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>

                                        <Grid Margin="0,24,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border x:Name="Paso1" Width="38" Height="38" CornerRadius="12" Grid.Row="0"
                                                    Background="{StaticResource BrochaExitoSuave}"
                                                    RenderTransformOrigin="0.5,0.5" Margin="0,0,14,0" VerticalAlignment="Top" Opacity="0">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="Paso1E"/>
                                                        <TranslateTransform x:Name="Paso1T"/>
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <Path Data="M4,12.5 L9.5,18 L20,6.5" Stroke="{StaticResource BrochaExito}"
                                                      StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                                <TextBlock Text="Carga tu catálogo" FontSize="13.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Productos con fotos, presentaciones y precios desde el módulo Productos." FontSize="11.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border x:Name="Paso2" Width="38" Height="38" CornerRadius="12" Grid.Row="1" Grid.Column="0"
                                                    Background="{StaticResource BrochaExitoSuave}"
                                                    RenderTransformOrigin="0.5,0.5" Margin="0,16,14,0" VerticalAlignment="Top" Opacity="0">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="Paso2E"/>
                                                        <TranslateTransform x:Name="Paso2T"/>
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <Path Data="M4,12.5 L9.5,18 L20,6.5" Stroke="{StaticResource BrochaExito}"
                                                      StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,0">
                                                <TextBlock Text="Ajusta tu tienda" FontSize="13.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Horarios, métodos de pago y delivery viven en Configuración." FontSize="11.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border x:Name="Paso3" Width="38" Height="38" CornerRadius="12" Grid.Row="2" Grid.Column="0"
                                                    Background="{StaticResource BrochaExitoSuave}"
                                                    RenderTransformOrigin="0.5,0.5" Margin="0,16,14,0" VerticalAlignment="Top" Opacity="0">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="Paso3E"/>
                                                        <TranslateTransform x:Name="Paso3T"/>
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <Path Data="M4,12.5 L9.5,18 L20,6.5" Stroke="{StaticResource BrochaExito}"
                                                      StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Margin="0,16,0,0">
                                                <TextBlock Text="Atiende los pedidos" FontSize="13.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Los pedidos del móvil llegan solos a Pedidos y al Inicio." FontSize="11.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="Nota4" Text="Puedes mover las tarjetas del Inicio como prefieras: el panel se recuerda por equipo."
                                                   FontSize="11" Foreground="#8C8C8C" HorizontalAlignment="Center" Margin="0,26,0,0"
                                                   RenderTransformOrigin="0.5,0.5" Opacity="0">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="Nota4T"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- ============ PIE DE NAVEGACIÓN ============ -->
                            <Grid Grid.Row="1" Margin="30,10,30,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BotonSaltar" Style="{StaticResource EnlaceSaltar}" FontSize="12"
                                        Content="Saltar introducción" Click="AlSaltar"
                                        AutomationProperties.Name="Saltar introducción"
                                        ToolTip="Cierra la introducción y entra al panel (Esc)"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="Punto1" Width="22" Height="8" CornerRadius="4" Background="#161616" Margin="3,0"/>
                                    <Border x:Name="Punto2" Width="8" Height="8" CornerRadius="4" Background="#40161616" Margin="3,0"/>
                                    <Border x:Name="Punto3" Width="8" Height="8" CornerRadius="4" Background="#40161616" Margin="3,0"/>
                                    <Border x:Name="Punto4" Width="8" Height="8" CornerRadius="4" Background="#40161616" Margin="3,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="BotonAnterior" Style="{StaticResource BotonAnterior}"
                                            Content="Anterior" Margin="0,0,10,0" Click="AlRetroceder"
                                            Visibility="Hidden"
                                            AutomationProperties.Name="Página anterior"/>
                                    <Button x:Name="BotonContinuar" Style="{StaticResource BotonContinuar}"
                                            Content="Continuar" IsDefault="True" Click="AlAvanzar"
                                            AutomationProperties.Name="Continuar a la siguiente página"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="Sistema protegido · COGANA 2026" FontSize="11" Foreground="#737373"
                       HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
