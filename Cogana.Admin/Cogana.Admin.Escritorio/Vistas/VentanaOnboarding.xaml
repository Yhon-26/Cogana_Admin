                </DrawingBrush>
            </Rectangle.Fill>
            <Rectangle.OpacityMask>
                <RadialGradientBrush>
                    <GradientStop Color="#FF161616" Offset="0.35"/>
                    <GradientStop Color="#00161616" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <!-- Capa 3: foco que sigue al mouse -->
        <Ellipse IsHitTestVisible="False" Width="960" Height="960" Opacity="0.9">
            <Ellipse.Fill>
