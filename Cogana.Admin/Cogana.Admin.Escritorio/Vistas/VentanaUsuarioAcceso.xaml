<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaUsuarioAcceso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrar acceso"
        Width="690" Height="670" MinWidth="650" MinHeight="610"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BrochaFondo}">
    <Grid Margin="22">
        <Border Background="{StaticResource BrochaSuperficie}"
                BorderBrush="#12000000" BorderThickness="1"
                CornerRadius="28" Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource BrochaNegro}">
                        <TextBlock Text="U" Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TituloFormulario" Text="Invitar usuario"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="25" FontWeight="SemiBold" />
                        <TextBlock x:Name="DescripcionFormulario"
                                   Text="Acceso del personal a la tienda Cogana"
                                   Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource BrochaAcentoSuave}"
                            CornerRadius="13" Padding="13,7" VerticalAlignment="Center">
                        <TextBlock x:Name="EtiquetaModo" Text="NUEVO ACCESO"
                                   Foreground="{StaticResource BrochaAcento}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="#EEF4F1" CornerRadius="17" Padding="15" Margin="0,22,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="12" Background="{StaticResource BrochaAcentoSuave}">
                            <TextBlock Text="✓" Foreground="{StaticResource BrochaAcento}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Acción protegida para propietarios" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="La invitación y los cambios se validan en Supabase y quedan auditados."
                                       Foreground="{StaticResource BrochaTextoSuave}" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,0,8,4">
                        <TextBlock Text="Correo electrónico *" FontSize="11" FontWeight="SemiBold" />
                        <TextBox x:Name="Correo" Style="{StaticResource CampoFormulario}" />

                        <TextBlock Text="Nombre completo *" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBox x:Name="NombreCompleto" Style="{StaticResource CampoFormulario}" />

                        <TextBlock Text="Teléfono" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBox x:Name="Telefono" Style="{StaticResource CampoFormulario}" />

                        <TextBlock Text="Rol en la tienda *" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <ComboBox x:Name="Rol" Style="{StaticResource SelectorFormulario}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Administrador" Tag="admin" />
                            <ComboBoxItem Content="Repartidor" Tag="driver" />
                            <ComboBoxItem Content="Propietario" Tag="owner" />
                        </ComboBox>

                        <StackPanel x:Name="SeccionContrasena" Margin="0,16,0,0">
                            <TextBlock Text="Contraseña inicial *" FontSize="11" FontWeight="SemiBold" />
                            <Border Background="White" BorderBrush="{StaticResource BrochaBorde}"
                                    BorderThickness="1" CornerRadius="12" Margin="0,7,0,0">
                                <PasswordBox x:Name="Contrasena" Height="42" Margin="13,0"
                                             Background="Transparent" BorderThickness="0"
                                             FontSize="13" VerticalContentAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Confirmar contraseña *" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,0" />
                            <Border Background="White" BorderBrush="{StaticResource BrochaBorde}"
                                    BorderThickness="1" CornerRadius="12" Margin="0,7,0,0">
                                <PasswordBox x:Name="ConfirmarContrasena" Height="42" Margin="13,0"
                                             Background="Transparent" BorderThickness="0"
                                             FontSize="13" VerticalContentAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Debe tener al menos 10 caracteres. Las cuentas nuevas deben cambiarla antes de abrir el panel. Si la cuenta ya existe, su contraseña actual se conserva."
                                       FontSize="10" Foreground="{StaticResource BrochaTextoSuave}"
                                       TextWrapping="Wrap" Margin="2,7,0,0" />
                        </StackPanel>

                        <Border x:Name="SeccionEstado" Visibility="Collapsed"
                                Background="#F4F4F2" CornerRadius="15" Padding="15" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Acceso a la tienda" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="Al suspenderlo, la cuenta deja de entrar al panel y a las operaciones."
                                               FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" Margin="0,4,15,0" />
                                </StackPanel>
                                <CheckBox x:Name="AccesoActivo" Grid.Column="1" Content="Activo"
                                          VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MensajeFormulario" Foreground="#9A443F" FontSize="11"
                               TextWrapping="Wrap" MinHeight="18" Margin="1,0,0,10" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cerrar" Click="AlCancelar" Style="{StaticResource BotonSecundario}" Margin="0,0,9,0" />
                        <Button x:Name="BotonGuardar" Content="Crear acceso" Click="AlGuardar"
                                Style="{StaticResource BotonPrincipal}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
