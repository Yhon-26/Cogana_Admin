<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaCambioEstadoPedido"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionar pedido · Cogana" Width="560" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrochaFondo}">
    <Grid Margin="18">
        <Border Background="{StaticResource BrochaSuperficie}" CornerRadius="28" Padding="32"
                BorderBrush="#10000000" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource BrochaNegro}" HorizontalAlignment="Left">
                        <TextBlock Text="PE" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TituloPedido" Text="Gestionar pedido" FontSize="26" FontWeight="SemiBold" Margin="0,17,0,0" />
                    <TextBlock x:Name="EstadoActual" Foreground="{StaticResource BrochaTextoSuave}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,25,0,18">
                    <TextBlock Text="Siguiente estado *" FontSize="11" FontWeight="SemiBold" />
                    <ComboBox x:Name="NuevoEstado" Style="{StaticResource SelectorFormulario}"
                              DisplayMemberPath="Nombre" SelectedValuePath="Codigo"
                              SelectionChanged="AlCambiarEstadoSeleccionado" />
                    <StackPanel x:Name="SeccionCancelacion" Visibility="Collapsed" Margin="0,15,0,0">
                        <TextBlock Text="Motivo de cancelación *" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="MotivoCancelacion" Style="{StaticResource SelectorFormulario}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Solicitud del cliente" Tag="customer_request" />
                            <ComboBoxItem Content="Producto sin stock" Tag="out_of_stock" />
                            <ComboBoxItem Content="Tienda cerrada" Tag="store_closed" />
                            <ComboBoxItem Content="Otro motivo" Tag="other" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="Nota interna" FontSize="11" FontWeight="SemiBold" Margin="0,15,0,0" />
                    <TextBox x:Name="Nota" Style="{StaticResource CampoFormulario}" Height="82"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                    <Border Background="{StaticResource BrochaAcentoSuave}" CornerRadius="15" Padding="14" Margin="0,17,0,0">
                        <TextBlock Text="El cambio se registra de forma transaccional en el historial del pedido."
                                   Foreground="{StaticResource BrochaAcento}" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="Mensaje" Foreground="#9A443F" FontSize="11" TextWrapping="Wrap" MinHeight="18" Margin="0,0,0,10" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="AlCancelar" Style="{StaticResource BotonSecundario}" Margin="0,0,9,0" />
                        <Button x:Name="BotonGuardar" Content="Confirmar cambio" Click="AlGuardar" Style="{StaticResource BotonPrincipal}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
