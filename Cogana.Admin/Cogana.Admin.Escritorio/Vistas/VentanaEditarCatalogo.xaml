<Window x:Class="Cogana.Admin.Escritorio.Vistas.VentanaEditarCatalogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar registro"
        Width="720"
        Height="650"
        MinWidth="680"
        MinHeight="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BrochaFondo}">
    <Grid Margin="22">
        <Border Background="{StaticResource BrochaSuperficie}"
                BorderBrush="#12000000" BorderThickness="1"
                CornerRadius="28" Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource BrochaNegro}">
                        <TextBlock x:Name="InicialModulo" Text="C" Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TituloFormulario" Text="Cargando registro..."
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="25" FontWeight="SemiBold" />
                        <TextBlock x:Name="DescripcionFormulario" Text="Información compartida con Cogana"
                                   Foreground="{StaticResource BrochaTextoSuave}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="EtiquetaEstado"
                            Background="{StaticResource BrochaAcentoSuave}"
                            CornerRadius="13" Padding="13,7" VerticalAlignment="Center">
                        <TextBlock x:Name="TextoEstado" Text="Consultando"
                                   Foreground="{StaticResource BrochaAcento}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BrochaBorde}"
                        BorderThickness="1" CornerRadius="17" Padding="15" Margin="0,22,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="12" Background="{StaticResource BrochaAcentoSuave}">
                            <TextBlock Text="↻" Foreground="{StaticResource BrochaAcento}" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Datos sincronizados con Supabase" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="DetalleSincronizacion" Text="Los cambios estarán disponibles para los canales conectados."
                                       Foreground="{StaticResource BrochaTextoSuave}" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="2,0,8,4">
                        <StackPanel x:Name="SeccionCategoria" Visibility="Collapsed">
                            <TextBlock Text="Nombre de la categoría *" FontSize="11" FontWeight="SemiBold" />
                            <TextBox x:Name="CategoriaNombre" Style="{StaticResource CampoFormulario}" />
                            <TextBlock Text="Orden de aparición *" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,0" />
                            <TextBox x:Name="CategoriaOrden" Style="{StaticResource CampoFormulario}" />
                            <Border Background="#F0F1EF" CornerRadius="15" Padding="14" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Identificador automático" FontSize="10" Foreground="{StaticResource BrochaTextoSuave}" />
                                    <TextBlock x:Name="CategoriaIdentificador" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SeccionPresentacion" Visibility="Collapsed">
                            <TextBlock Text="Producto *" FontSize="11" FontWeight="SemiBold" />
                            <ComboBox x:Name="PresentacionProducto" Style="{StaticResource SelectorFormulario}"
                                      DisplayMemberPath="Nombre" SelectedValuePath="Id" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,7,0">
                                    <TextBlock Text="Nombre de la presentación *" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="PresentacionNombre" Style="{StaticResource CampoFormulario}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                    <TextBlock Text="SKU" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="PresentacionSku" Style="{StaticResource CampoFormulario}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,7,0">
                                    <TextBlock Text="Tipo *" FontSize="11" FontWeight="SemiBold" />
                                    <ComboBox x:Name="PresentacionTipo" Style="{StaticResource SelectorFormulario}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="A granel" Tag="bulk" />
                                        <ComboBoxItem Content="Unidad" Tag="unit" />
                                        <ComboBoxItem Content="Paquete" Tag="package" />
                                        <ComboBoxItem Content="Caja" Tag="box" />
                                        <ComboBoxItem Content="Saco" Tag="sack" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                    <TextBlock Text="Cantidad base *" FontSize="11" FontWeight="SemiBold" />
                                    <TextBox x:Name="PresentacionCantidad" Style="{StaticResource CampoFormulario}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Precio en soles *" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,0" />
                            <TextBox x:Name="PresentacionPrecio" Style="{StaticResource CampoFormulario}" />
                            <CheckBox x:Name="PresentacionSellada" Content="Presentación sellada"
                                      Margin="2,17,0,0" FontSize="12" />
                        </StackPanel>

                        <StackPanel x:Name="SeccionProveedor" Visibility="Collapsed">
                            <TextBlock Text="Nombre o razón social *" FontSize="11" FontWeight="SemiBold" />
                            <TextBox x:Name="ProveedorNombre" Style="{StaticResource CampoFormulario}" />
                            <TextBlock Text="RUC" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,0" />
                            <TextBox x:Name="ProveedorRuc" Style="{StaticResource CampoFormulario}" MaxLength="11" />
                            <TextBlock Text="Teléfono" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,0" />
                            <TextBox x:Name="ProveedorTelefono" Style="{StaticResource CampoFormulario}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MensajeFormulario" Foreground="#9A443F" FontSize="11"
                               TextWrapping="Wrap" MinHeight="18" Margin="1,0,0,10" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cerrar" Click="AlCancelar" Style="{StaticResource BotonSecundario}" Margin="0,0,9,0" />
                        <Button x:Name="BotonGuardar" Content="Guardar cambios" Click="AlGuardar"
                                Style="{StaticResource BotonPrincipal}" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
